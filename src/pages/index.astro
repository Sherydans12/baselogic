---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import HomeHero from '../components/HomeHero.astro';
import WhatWeDoSection from '../components/WhatWeDoSection.astro';
import OperationalClaritySection from '../components/OperationalClaritySection.astro';
import MainServicesSection from '../components/MainServicesSection.astro';
import ProductsPreviewSection from '../components/ProductsPreviewSection.astro';
import IndustriesUseCasesSection from '../components/IndustriesUseCasesSection.astro';
import PlansPreviewSection from '../components/PlansPreviewSection.astro';
import FinalCtaSection from '../components/FinalCtaSection.astro';
import { seo } from '../data/seo';
import { generalFaqs } from '../data/faqs';
import { contact } from '../data/contact';
import { baseSchema, faqSchema } from '../data/schema';

const pageSeo = seo.home;
const schema = [...baseSchema(pageSeo.description), faqSchema(generalFaqs)];
---

<Layout
  title={pageSeo.title}
  description={pageSeo.description}
  canonicalPath={pageSeo.path}
  schema={schema}
  whatsappMessage={contact.whatsappMessages.general}
>
  <SiteHeader />
  <main>
    <HomeHero />
    <WhatWeDoSection />
    <OperationalClaritySection />
    <MainServicesSection />
    <ProductsPreviewSection />
    <IndustriesUseCasesSection />
    <PlansPreviewSection />
    <FinalCtaSection />
  </main>
  <SiteFooter />
</Layout>
