---
import { ArrowDownRight, Info } from 'lucide-react';
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import ContactBand from '../components/ContactBand.astro';
import FaqBlock from '../components/FaqBlock.astro';
import { caseStudies } from '../data/caseStudies';
import { seo } from '../data/seo';
import { contact } from '../data/contact';
import { caseStudyFaqs } from '../data/faqs';
import { baseSchema, breadcrumbSchema, faqSchema } from '../data/schema';
import '../styles/interior-pages.css';

const pageSeo = seo.caseStudies;
const breadcrumbItems = [
  { label: 'Inicio', href: '/' },
  { label: 'Casos de uso' },
];
const schema = [...baseSchema(pageSeo.description), faqSchema(caseStudyFaqs), breadcrumbSchema(breadcrumbItems)];
---

<Layout title={pageSeo.title} description={pageSeo.description} canonicalPath={pageSeo.path} schema={schema} whatsappMessage={contact.whatsappMessages.caseStudies}>
  <SiteHeader />
  <main class="interior-page">
    <Breadcrumbs items={breadcrumbItems} containerClass="interior-shell" />
    <section class="case-intro" aria-labelledby="cases-heading">
      <div class="interior-shell">
        <div class="case-intro__header">
          <h1 id="cases-heading" class="interior-title">Casos de uso <span>por rubro</span></h1>
          <p class="interior-lede">
            Explora cómo un sitio web, una agenda en línea o un sistema de gestión pueden responder a los desafíos de distintas operaciones.
          </p>
        </div>

        <nav aria-label="Explorar los casos por rubro">
          <ul class="case-index">
            {caseStudies.map(({ id, sector }) => (
              <li>
                <a href={`#${id}`}>
                  <img src={`/images/recursos/${id}.webp`} alt="" width="640" height="420" decoding="async" />
                  <span>{sector}<ArrowDownRight width={18} height={18} aria-hidden="true" /></span>
                </a>
              </li>
            ))}
          </ul>
        </nav>

        <p class="case-intro__note">
          <Info width={17} height={17} aria-hidden="true" />
          <span>Escenarios representativos con resultados esperados. Resguardamos la información de nuestros clientes.</span>
        </p>
      </div>
    </section>

    <div class="interior-shell">
      {caseStudies.map((item) => <CaseStudyCard {...item} />)}
    </div>

    <section id="preguntas-frecuentes" class="case-questions" aria-labelledby="case-questions-title">
      <div class="interior-shell case-questions__layout">
        <h2 id="case-questions-title" class="interior-heading">Sobre estos escenarios</h2>
        <FaqBlock faqs={caseStudyFaqs} />
      </div>
    </section>

    <ContactBand
      title="¿Buscas una solución para tu rubro?"
      text="Cuéntanos qué tipo de negocio tienes y qué proceso necesitas ordenar. Podemos orientarte hacia una web, una landing, Booking, EduPay, EAM, automatización o soporte."
      primaryLabel="Evaluar solución para mi rubro"
      primaryHref="/contacto#formulario"
      whatsappMessage={contact.whatsappMessages.caseStudies}
    />
  </main>
  <SiteFooter />
</Layout>

<style>
  .case-intro {
    --interior-lede-color: #d6e7ff;
    --interior-focus: #7fe5ff;

    margin-top: 1.25rem;
    padding-block: clamp(2rem, 5vw, 4rem) clamp(1.75rem, 3.5vw, 2.75rem);
    background:
      radial-gradient(ellipse at 92% 0%, #1a5197, transparent 56%),
      var(--interior-navy);
    color: white;
  }

  .case-intro__header {
    display: grid;
    align-items: end;
    gap: 1rem 4rem;
    margin-bottom: clamp(1.5rem, 3.5vw, 2.5rem);
  }

  .case-intro h1 {
    max-width: 14ch;
    text-wrap: pretty;
  }

  .case-intro h1 span {
    color: #85e1ff;
  }

  .case-intro .interior-lede {
    max-width: 48ch;
  }

  .case-index {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.375rem;
    border-radius: 0.875rem;
  }

  .case-index li:last-child {
    grid-column: 1 / -1;
  }

  .case-index a {
    position: relative;
    display: flex;
    min-height: clamp(6rem, 13vw, 11.5rem);
    align-items: end;
    overflow: hidden;
    isolation: isolate;
    border-radius: 0.5rem;
    background: #193c62;
  }

  .case-index a::after {
    position: absolute;
    z-index: -1;
    inset: 0;
    background: linear-gradient(180deg, transparent 15%, rgb(5 18 39 / 94%) 100%);
    content: '';
  }

  .case-index a:focus-visible {
    outline-offset: -3px;
  }

  .case-index img {
    position: absolute;
    z-index: -2;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .case-index a span {
    display: flex;
    width: 100%;
    align-items: end;
    justify-content: space-between;
    gap: 0.375rem;
    padding: 0.75rem;
    font-size: clamp(0.875rem, 1.1vw, 1rem);
    font-weight: 750;
    line-height: 1.25;
  }

  .case-index svg {
    flex: none;
    color: #a5eaff;
  }

  .case-index a:hover span {
    text-decoration: underline;
  }

  .case-intro__note {
    display: flex;
    align-items: start;
    gap: 0.625rem;
    margin-top: 1.125rem;
    color: #c2d8f7;
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .case-intro__note svg {
    flex: none;
    margin-top: 0.125rem;
    color: #85e1ff;
  }

  .case-questions {
    padding-block: clamp(2.25rem, 5vw, 4rem);
    background: var(--interior-ice);
  }

  .case-questions__layout {
    display: grid;
    gap: 1.25rem 4rem;
  }

  @media (min-width: 48rem) {
    .case-intro__header,
    .case-questions__layout {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    }

    .case-index {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      overflow: hidden;
    }

    .case-index li:last-child {
      grid-column: auto;
    }

    .case-index a {
      border-radius: 0;
    }
  }

  @media (min-width: 64rem) {
    .case-index a span {
      padding: 1rem;
    }
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .case-index img {
      transition: transform 320ms ease-out;
    }

    .case-index a:hover img {
      transform: scale(1.055);
    }
  }
</style>
