---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ListingHero from '../components/ListingHero.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import ContactBand from '../components/ContactBand.astro';
import FaqBlock from '../components/FaqBlock.astro';
import { caseStudies } from '../data/caseStudies';
import { seo } from '../data/seo';
import { contact } from '../data/contact';
import { caseStudyFaqs } from '../data/faqs';
import { baseSchema, breadcrumbSchema, faqSchema } from '../data/schema';

const pageSeo = seo.caseStudies;
const breadcrumbItems = [
  { label: 'Inicio', href: '/' },
  { label: 'Casos de uso' },
];
const schema = [...baseSchema(pageSeo.description), faqSchema(caseStudyFaqs), breadcrumbSchema(breadcrumbItems)];
---

<Layout title={pageSeo.title} description={pageSeo.description} canonicalPath={pageSeo.path} schema={schema} whatsappMessage={contact.whatsappMessages.caseStudies}>
  <SiteHeader />
  <main>
    <Breadcrumbs items={breadcrumbItems} />
    <ListingHero
      eyebrow="Escenarios por rubro"
      title="Soluciones y escenarios de aplicación por rubro"
      text="Estos escenarios representan problemas operacionales frecuentes en pymes, educación e industria, junto con la arquitectura de solución que implementa BaseLogic."
    />

    <section class="bg-white py-14">
      <div class="mx-auto max-w-7xl px-5 md:px-8">
        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-6">
          <p class="text-lg font-semibold leading-8 text-slate-700">
            Nota de transparencia: Los siguientes bloques describen escenarios representativos de aplicación por industria para ilustrar problemas frecuentes, arquitecturas posibles y resultados operacionales esperados, resguardando la confidencialidad de nuestros clientes.
          </p>
        </div>
      </div>
    </section>

    <section class="bg-slate-50 py-18 md:py-20">
      <div class="mx-auto grid max-w-7xl gap-5 px-5 md:px-8 lg:grid-cols-2">
        {caseStudies.map((item) => (
          <CaseStudyCard {...item} />
        ))}
      </div>
    </section>

    <FaqBlock faqs={caseStudyFaqs} title="Sobre estos escenarios" />

    <ContactBand
      title="¿Buscas una solución para tu rubro?"
      text="Cuéntanos qué tipo de negocio tienes y qué proceso necesitas ordenar. Podemos orientarte hacia una web, una landing, Booking, EduPay, EAM, automatización o soporte."
      primaryLabel="Evaluar solución para mi rubro"
      secondaryLabel="Cotizar proyecto"
      whatsappMessage={contact.whatsappMessages.caseStudies}
    />
  </main>
  <SiteFooter />
</Layout>
