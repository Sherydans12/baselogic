---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ListingHero from '../components/ListingHero.astro';
import FinalCtaSection from '../components/FinalCtaSection.astro';
import { plans, plansNotes } from '../data/plans';
import { seo } from '../data/seo';
import { contact } from '../data/contact';
import { baseSchema } from '../data/schema';

const pageSeo = seo.plans;
const schema = baseSchema(pageSeo.description);
---

<Layout title={pageSeo.title} description={pageSeo.description} canonicalPath={pageSeo.path} schema={schema} whatsappMessage={contact.whatsappMessages.plans}>
  <SiteHeader />
  <main>
    <ListingHero
      eyebrow="Planes"
      title="Planes web y soporte digital para partir con claridad"
      text="Estos valores son referencias para orientar una primera cotizacion. Cada proyecto se ajusta segun alcance, contenido, integraciones y soporte requerido."
    />

    <section class="bg-white py-20">
      <div class="mx-auto max-w-7xl px-5 md:px-8">
        <div class="grid gap-5 lg:grid-cols-3">
          {plans.map((plan) => (
            <article class="rounded-2xl border border-slate-200 bg-slate-50 p-6">
              <h2 class="text-3xl font-black text-slate-950">{plan.name}</h2>
              <p class="mt-4 text-sm font-semibold uppercase tracking-wide text-slate-500">Desde</p>
              <p class="mt-1 text-4xl font-black text-brand-blue">{plan.price}</p>
              <p class="mt-5 leading-7 text-slate-600">{plan.summary}</p>
              <p class="mt-4 text-sm font-bold text-slate-700">{plan.idealFor}</p>
              <ul class="mt-6 space-y-3 text-sm text-slate-700">
                {plan.includes.map((item) => (
                  <li class="flex gap-2">
                    <span class="mt-2 h-1.5 w-1.5 rounded-full bg-brand-cyan"></span>
                    {item}
                  </li>
                ))}
              </ul>
              <a href="/contacto" class="mt-8 inline-flex rounded-full bg-brand-blue px-5 py-3 text-sm font-bold text-white hover:bg-slate-950">
                Cotizar este plan
              </a>
            </article>
          ))}
        </div>
        <div class="mt-8 rounded-2xl border border-slate-200 bg-white p-6 text-base leading-8 text-slate-600 shadow-sm">
          {plansNotes.map((note) => <p>{note}</p>)}
        </div>
      </div>
    </section>

    <FinalCtaSection />
  </main>
  <SiteFooter />
</Layout>
