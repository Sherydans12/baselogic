---
import { ArrowRight, CalendarDays, Check, GraduationCap, Layers3, Settings, Store } from 'lucide-react';
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import FinalCtaSection from '../../components/FinalCtaSection.astro';
import { products } from '../../data/products';
import { seo } from '../../data/seo';
import { contact } from '../../data/contact';
import { baseSchema } from '../../data/schema';

const pageSeo = seo.products;
const schema = baseSchema(pageSeo.description);
const visuals = {
  booking: { icon: CalendarDays, image: '/images/productos/baselogic-booking.webp', area: 'Reservas y atención' },
  edupay: { icon: GraduationCap, image: '/images/productos/baselogic-edupay.webp', area: 'Gestión educativa' },
  eam: { icon: Settings, image: '/images/productos/baselogic-eam.webp', area: 'Activos y mantenimiento' },
  pos: { icon: Store, image: '/images/productos/baselogic-pos.webp', area: 'Comercio y punto de venta' },
};
---

<Layout title={pageSeo.title} description={pageSeo.description} canonicalPath={pageSeo.path} schema={schema} whatsappMessage={contact.whatsappMessages.products}>
  <SiteHeader />
  <main>
    <section class="border-b border-[#dce8f8] bg-[#f7faff] py-12 md:py-16">
      <div class="mx-auto grid max-w-7xl items-center gap-9 px-5 md:px-8 lg:grid-cols-[1fr_0.9fr] lg:gap-14">
        <div>
          <p class="inline-flex items-center gap-2 text-sm font-bold text-[#1558c6]"><Layers3 class="h-4 w-4" aria-hidden="true" /> Productos BaseLogic</p>
          <h1 class="mt-4 max-w-2xl text-3xl font-black leading-[1.1] tracking-[-0.03em] text-[#0b1a4c] sm:text-4xl xl:text-[2.9rem]">Software diseñado para conectar tu operación</h1>
          <p class="mt-5 max-w-2xl text-base leading-relaxed text-[#405578] sm:text-lg">Plataformas especializadas que reúnen equipos, información y procesos esenciales en una experiencia más clara.</p>
          <div class="mt-7 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <a href="#plataformas" class="group inline-flex min-h-12 items-center justify-center gap-2 rounded-xl bg-[#0964ef] px-5 py-3 text-sm font-bold text-white transition-colors hover:bg-[#064bb7] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#075be8]">Explorar productos <ArrowRight class="h-4 w-4 transition-transform group-hover:translate-x-1" aria-hidden="true" /></a>
            <a href="/contacto?tipo=productos#formulario" class="inline-flex min-h-12 items-center justify-center rounded-xl border border-[#c9daf1] bg-white px-5 py-3 text-sm font-bold text-[#0754c9] transition-colors hover:border-[#0964ef] hover:bg-[#edf5ff] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#075be8]">Hablar con BaseLogic</a>
          </div>
        </div>
        <figure class="min-w-0 overflow-hidden rounded-3xl border border-[#d9e7f8] bg-white shadow-sm">
          <img
            src="/images/productos/panel-de-gestion-baselogic.webp"
            alt="Panel de gestión BaseLogic en un computador portátil, acompañado por una aplicación móvil."
            width="1536"
            height="1024"
            fetchpriority="high"
            decoding="async"
            class="block h-auto w-full"
          />
        </figure>
      </div>
    </section>

    <section id="plataformas" class="scroll-mt-24 bg-white py-14 md:py-16" aria-labelledby="platforms-heading">
      <div class="mx-auto max-w-7xl px-5 md:px-8">
        <div class="grid gap-4 lg:grid-cols-2 lg:items-end lg:gap-12">
          <h2 id="platforms-heading" class="text-3xl font-black tracking-[-0.03em] text-[#0b1a4c] sm:text-4xl">Una solución para cada operación</h2>
          <p class="max-w-xl text-base leading-relaxed text-[#405578]">Explora cada plataforma, sus funciones y el tipo de trabajo que ayuda a organizar.</p>
        </div>
        <div class="mt-8 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
          {products.map((product) => {
            const visual = visuals[product.id as keyof typeof visuals];
            const Icon = visual.icon;
            return <article class="group flex min-w-0 flex-col overflow-hidden rounded-2xl border border-[#dce8f8] bg-white transition-colors hover:border-[#9fc5f8]">
              <img src={visual.image} alt="" aria-hidden="true" width="1040" height="620" loading="lazy" decoding="async" class="block h-auto w-full" />
              <div class="flex flex-1 flex-col p-5">
                <p class="inline-flex items-center gap-2 text-xs font-bold text-[#315b98]"><Icon class="h-4 w-4 text-[#0964ef]" aria-hidden="true" />{visual.area}</p>
                <h3 class="mt-3 text-xl font-extrabold tracking-[-0.025em] text-[#0b1a4c]">{product.name}</h3>
                <p class="mt-3 text-sm leading-relaxed text-[#405578]">{product.summary}</p>
                <ul class="mt-5 grid gap-2.5 text-sm leading-snug text-[#243b61]">
                  {product.features.slice(0, 3).map((feature) => <li class="flex items-start gap-2"><Check class="mt-0.5 h-4 w-4 shrink-0 text-[#0964ef]" aria-hidden="true" /><span>{feature}</span></li>)}
                </ul>
                <a href={product.href} aria-label={`Conocer ${product.name}`} class="mt-auto inline-flex min-h-11 w-fit items-center gap-2 pt-5 text-sm font-bold text-[#0754c9] hover:text-[#0b1a4c] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#075be8]">Conocer producto <ArrowRight class="h-4 w-4 transition-transform group-hover:translate-x-1" aria-hidden="true" /></a>
              </div>
            </article>;
          })}
        </div>
      </div>
    </section>
    <section class="bg-[#f1f6ff] py-14 md:py-16"><div class="mx-auto grid max-w-7xl gap-8 px-5 md:px-8 lg:grid-cols-2 lg:gap-12"><div><h2 class="text-3xl font-black tracking-[-0.03em] text-[#0b1a4c]">Conecta lo que hoy funciona por separado</h2><p class="mt-4 max-w-xl leading-relaxed text-[#405578]">El valor de una plataforma está en conectar las tareas diarias, acercar información a cada equipo y ofrecer una visión más clara de la operación.</p></div><div class="rounded-2xl border border-[#dce8f8] bg-white p-6 sm:p-8"><h3 class="text-xl font-extrabold text-[#0b1a4c]">¿Qué operación quieres conectar?</h3><p class="mt-3 leading-relaxed text-[#405578]">Educación, activos, comercio o atención: conversemos sobre el proceso que quieres mejorar y encontremos la solución para tu equipo.</p><a href="/contacto?tipo=productos#formulario" class="mt-5 inline-flex min-h-11 items-center gap-2 font-bold text-[#0754c9] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#075be8]">Cotizar una plataforma <ArrowRight class="h-4 w-4" aria-hidden="true" /></a></div></div></section>
    <FinalCtaSection />
  </main>
  <SiteFooter />
</Layout>
