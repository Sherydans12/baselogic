---
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import ListingHero from '../../components/ListingHero.astro';
import FinalCtaSection from '../../components/FinalCtaSection.astro';
import { products } from '../../data/products';
import { seo } from '../../data/seo';
import { contact } from '../../data/contact';
import { baseSchema } from '../../data/schema';

const pageSeo = seo.products;
const schema = baseSchema(pageSeo.description);
---

<Layout title={pageSeo.title} description={pageSeo.description} canonicalPath={pageSeo.path} schema={schema} whatsappMessage={contact.whatsappMessages.products}>
  <SiteHeader />
  <main>
    <ListingHero
      eyebrow="Productos"
      title="Plataformas BaseLogic para resolver necesidades operacionales concretas"
      text="Desarrollamos software propio para reservas, gestión financiera educativa, control de activos y punto de venta e inventario en implementación piloto."
    />

    <section class="bg-white py-20">
      <div class="mx-auto grid max-w-7xl gap-6 px-5 md:px-8 md:grid-cols-2">
        {products.map((product) => (
          <article class:list={[
            'rounded-2xl border p-6 shadow-sm',
            product.id === 'booking' ? 'border-brand-blue bg-brand-soft' : 'border-slate-200 bg-slate-50',
          ]}>
            <p class="mb-4 text-sm font-bold uppercase tracking-wide text-brand-blue">{product.eyebrow}</p>
            <h2 class="text-3xl font-black text-slate-950">{product.name}</h2>
            <p class="mt-3 text-lg font-semibold text-slate-700">{product.tagline}</p>
            <p class="mt-4 leading-7 text-slate-600">{product.summary}</p>
            <p class="mt-4 text-sm font-semibold text-slate-500">{product.audience}</p>
            <a href={product.href} class="mt-6 inline-flex rounded-full bg-brand-blue px-5 py-3 text-sm font-bold text-white hover:bg-slate-950">
              {product.ctaLabel}
            </a>
          </article>
        ))}
      </div>
    </section>
    <FinalCtaSection />
  </main>
  <SiteFooter />
</Layout>
