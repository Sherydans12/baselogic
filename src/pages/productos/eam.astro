---
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import ListingHero from '../../components/ListingHero.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import FaqBlock from '../../components/FaqBlock.astro';
import FinalCtaSection from '../../components/FinalCtaSection.astro';
import { products } from '../../data/products';
import { eamFaqs } from '../../data/faqs';
import { seo } from '../../data/seo';
import { contact } from '../../data/contact';
import { baseSchema, faqSchema, softwareApplicationSchema } from '../../data/schema';
import { visualAssets } from '../../data/visualAssets';

const product = products.find((item) => item.id === 'eam')!;
const pageSeo = seo.eam;
const schema = [...baseSchema(pageSeo.description), softwareApplicationSchema(product, pageSeo), faqSchema(eamFaqs)];
---

<Layout title={pageSeo.title} description={pageSeo.description} canonicalPath={pageSeo.path} schema={schema} whatsappMessage={contact.whatsappMessages.eam}>
  <SiteHeader />
  <main>
    <ListingHero
      eyebrow={product.eyebrow}
      title={product.name}
      text={product.tagline}
      asset={visualAssets.products.eamHero}
      ctaLabel="Cotizar EAM"
      ctaHref="/contacto"
      visualAspectRatio="aspect-[4/5] sm:aspect-[16/10]"
    />

    <section class="bg-white py-20">
      <div class="mx-auto grid max-w-7xl gap-10 px-5 md:px-8 lg:grid-cols-[1fr_0.9fr]">
        <div>
          <SectionHeading
            title="Control para activos, mantenimiento, inventario y operaciones"
            text={product.summary}
          />
          <p class="text-lg leading-8 text-slate-600">{product.audience}</p>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-slate-950 p-6 text-white">
          <h2 class="text-2xl font-black">Modulos y capacidades</h2>
          <ul class="mt-6 grid gap-4">
            {product.features.map((feature) => (
              <li class="rounded-2xl border border-white/10 bg-white/5 p-4 font-bold text-slate-100">{feature}</li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <section class="bg-slate-50 py-20">
      <div class="mx-auto max-w-7xl px-5 md:px-8">
        <SectionHeading
          title="Pensado para operaciones con mayor exigencia"
          text="EAM queda visible como producto avanzado para mineria, empresas medianas y equipos que necesitan trazabilidad sobre activos, ordenes de trabajo, mantenimiento, inventario y reportes operacionales."
        />
      </div>
    </section>

    <FaqBlock faqs={eamFaqs} />
    <FinalCtaSection />
  </main>
  <SiteFooter />
</Layout>
