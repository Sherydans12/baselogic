---
import { BarChart3, ClipboardList, HardHat, Package, ShoppingCart, Warehouse, Workflow, Wrench } from 'lucide-react';
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import ProductHero from '../../components/ProductHero.astro';
import ProductRelated from '../../components/ProductRelated.astro';
import ProductWorkflow from '../../components/ProductWorkflow.astro';
import HomeFaqSection from '../../components/HomeFaqSection.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import ContactBand from '../../components/ContactBand.astro';
import { products } from '../../data/products';
import { eamFaqs } from '../../data/faqs';
import { seo } from '../../data/seo';
import { contact } from '../../data/contact';
import { baseSchema, breadcrumbSchema, faqSchema, softwareApplicationSchema } from '../../data/schema';

const product = products.find((item) => item.id === 'eam')!;
const pageSeo = seo.eam;
const capabilities = [
  {
    title: 'Activos y hoja de vida',
    text: 'Mantén organizada la información técnica, historial y estado de cada equipo, vehículo o componente.',
    icon: HardHat,
  },
  {
    title: 'Órdenes de trabajo',
    text: 'Registra trabajos, responsables, prioridades, avances y comentarios desde un flujo centralizado.',
    icon: ClipboardList,
  },
  {
    title: 'Mantenimiento preventivo y correctivo',
    text: 'Organiza pautas e intervenciones programadas o correctivas junto a la información de cada equipo.',
    icon: Wrench,
  },
  {
    title: 'Compras y proveedores',
    text: 'Ordena solicitudes, proveedores y órdenes de compra para acompañar el abastecimiento de la operación.',
    icon: ShoppingCart,
  },
  {
    title: 'Recepción y bodegas',
    text: 'Relaciona la recepción de materiales con existencias, movimientos y control de repuestos en bodega.',
    icon: Warehouse,
  },
  {
    title: 'Consumos y Kardex',
    text: 'Consulta movimientos de inventario y consumos asociados al trabajo de mantenimiento.',
    icon: Package,
  },
  {
    title: 'Trazabilidad operacional',
    text: 'Consulta qué se hizo, cuándo se realizó, quién participó y qué materiales fueron utilizados.',
    icon: Workflow,
  },
  {
    title: 'Costos e información de gestión',
    text: 'Relaciona materiales y costos con el trabajo para dar contexto a las decisiones de supervisión.',
    icon: BarChart3,
  },
];

const steps = [
  { title: 'Orden de trabajo', text: 'Identifica el activo, la intervención y su responsable.' },
  { title: 'Requerimiento', text: 'Determina los repuestos y materiales necesarios.' },
  { title: 'Compra', text: 'Coordina la solicitud con compras y proveedores.' },
  { title: 'Recepción', text: 'Registra la llegada de los materiales.' },
  { title: 'Bodega', text: 'Ubica existencias y movimientos de stock.' },
  { title: 'Ejecución', text: 'Relaciona el consumo de repuestos con el trabajo.' },
  { title: 'Costo y trazabilidad', text: 'Consulta los antecedentes y costos disponibles de la intervención.' },
];

const miningUseCases = [
  {
    title: 'Equipos de alto tonelaje',
    text: 'Organiza mantenimiento e historial de camiones, excavadoras, cargadores y otros equipos pesados.',
  },
  {
    title: 'Movimiento de tierra',
    text: 'Centraliza el control de maquinaria utilizada en excavación, nivelación, carga y transporte.',
  },
  {
    title: 'Perforación y drilling',
    text: 'Registra activos, mantenimientos, intervenciones y repuestos asociados a equipos de perforación.',
  },
  {
    title: 'Grúas e izaje',
    text: 'Mantén trazabilidad de equipos, componentes, inspecciones y trabajos de mantenimiento.',
  },
  {
    title: 'Flotas de apoyo',
    text: 'Gestiona camionetas, vehículos de servicio y otros activos que apoyan la operación en terreno.',
  },
  {
    title: 'Talleres y bodegas',
    text: 'Conecta las órdenes de trabajo con repuestos, movimientos de inventario y responsables.',
  },
];

const benefits = [
  'Menos dependencia de planillas dispersas.',
  'Mayor claridad sobre trabajos pendientes.',
  'Historial técnico centralizado.',
  'Mejor coordinación entre mantenimiento, terreno y bodega.',
  'Información organizada para supervisores y administradores.',
];

const schema = [
  ...baseSchema(pageSeo.description),
  breadcrumbSchema([
    { label: 'Inicio', href: '/' },
    { label: 'Productos', href: '/productos' },
    { label: 'BaseLogic EAM', href: pageSeo.path },
  ]),
  softwareApplicationSchema(product, pageSeo),
  faqSchema(eamFaqs),
];
---

<Layout title={pageSeo.title} description={pageSeo.description} canonicalPath={pageSeo.path} schema={schema} whatsappMessage={contact.whatsappMessages.eam}>
  <SiteHeader />
  <main>
    <ProductHero productId="eam" title="Controla tus activos y conecta toda tu operación" description="Del mantenimiento a la compra y consumo de un repuesto: equipos, trabajos y abastecimiento con mayor trazabilidad." ctaLabel="Solicitar demostración" heroImageSrc="/images/productos/baselogic-eam-hero.webp" heroImageAlt="Panel de gestión BaseLogic EAM para órdenes de trabajo, activos y mantenimiento en faena minera." heroImageWidth={1536} heroImageHeight={1024} showVisualCaption={false} />

    <section id="funcionalidades" class="scroll-mt-24 bg-[#f4f8ff] py-20 md:py-24">
      <div class="mx-auto max-w-7xl px-5 md:px-8">
        <div class="grid items-end gap-6 lg:grid-cols-[1.1fr_0.9fr] lg:gap-12">
          <div>
            <p class="mb-5 inline-flex rounded-full bg-[#d9f7ff] px-4 py-2 text-sm font-extrabold uppercase tracking-[0.08em] text-[#075caa]">Control operacional</p>
            <h2 class="max-w-4xl text-3xl font-black leading-[1.12] tracking-[-0.035em] text-[#0b1a4c] md:text-[2.6rem]">Más control para operaciones donde cada detención importa</h2>
          </div>
          <p class="max-w-2xl pb-1 text-base leading-7 text-[#405578] md:text-lg md:leading-8">BaseLogic EAM reúne información de activos, mantenimiento y abastecimiento. Conecta el trabajo técnico con compras, recepción, bodegas y consumos para dar más contexto a las decisiones de tu equipo.</p>
        </div>

        <div class="mt-10 grid items-stretch gap-4 md:grid-cols-2 xl:mt-12 xl:grid-cols-4 xl:gap-5">
          {capabilities.map((capability) => {
            const CapabilityIcon = capability.icon;

            return (
              <article class="rounded-2xl bg-white p-6 shadow-[0_8px_24px_rgba(11,26,76,0.07)] sm:p-7">
                <span class="flex size-16 items-center justify-center rounded-2xl bg-[#edf6ff] text-[#075be8]">
                  <CapabilityIcon size={32} strokeWidth={1.8} aria-hidden="true" />
                </span>
                <h3 class="mt-4 text-xl font-extrabold leading-tight tracking-[-0.025em] text-[#0b1a4c]">{capability.title}</h3>
                <p class="mt-3 text-base leading-6 text-[#405578]">{capability.text}</p>
              </article>
            );
          })}
        </div>
      </div>
    </section>

    <ProductWorkflow title="De la orden de trabajo al costo de la intervención" description="Un recorrido que conecta mantenimiento, abastecimiento, bodega y supervisión alrededor del activo." steps={steps} />

    <section class="bg-white py-14 md:py-20">
      <div class="mx-auto grid max-w-7xl items-center gap-8 px-5 md:px-8 lg:grid-cols-2 lg:gap-12">
        <div class="space-y-7">
          <div>
            <h2 class="text-3xl font-black tracking-[-0.03em] text-[#0b1a4c]">Información para cada área de la operación</h2>
            <p class="mt-4 max-w-xl leading-relaxed text-[#405578]">Supervisión coordina el trabajo; mantenimiento registra intervenciones; compras y bodega se ocupan de los materiales que las hacen posibles.</p>
          </div>
          <aside class="rounded-2xl bg-[#f1f6ff] p-6 sm:p-8">
            <h3 class="text-xl font-extrabold text-[#0b1a4c]">Terreno y conectividad intermitente</h3>
            <p class="mt-3 leading-relaxed text-[#405578]">Las faenas remotas, talleres y obras no siempre tienen señal estable. El diseño de la operación debe considerar la conectividad disponible y las necesidades de continuidad de cada equipo.</p>
          </aside>
        </div>
        <figure class="overflow-hidden rounded-3xl shadow-[0_16px_40px_rgba(11,26,76,0.14)]">
          <img src="/images/productos/eam-trabajo-en-terreno.webp" alt="Técnico minero consulta una tableta junto a un camión de alto tonelaje en terreno." width="1672" height="941" loading="lazy" decoding="async" class="aspect-[16/10] w-full object-cover" />
        </figure>
      </div>
    </section>

    <section class="bg-slate-50 py-20">
      <div class="mx-auto max-w-7xl px-5 md:px-8">
        <SectionHeading
          eyebrow="Casos de uso"
          title="Preparado para empresas que trabajan con activos críticos"
          text="Organiza el mantenimiento y la trazabilidad de equipos, componentes y flotas que sostienen el trabajo diario en terreno."
        />

        <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          {miningUseCases.map((useCase) => (
            <article class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
              <h3 class="text-xl font-black text-slate-950">{useCase.title}</h3>
              <p class="mt-3 leading-7 text-slate-600">{useCase.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-slate-950 py-20 text-white">
      <div class="mx-auto grid max-w-7xl gap-12 px-5 md:px-8 lg:grid-cols-[1.15fr_0.85fr] lg:items-start">
        <div>
          <p class="mb-3 text-sm font-bold uppercase tracking-wide text-brand-cyan">Una plataforma adaptable</p>
          <h2 class="text-3xl font-bold tracking-tight md:text-4xl">Pensado para contratistas y operaciones intensivas en activos</h2>
          <p class="mt-5 max-w-3xl text-lg leading-8 text-slate-300">
            BaseLogic EAM puede adaptarse a empresas de mantenimiento, movimiento de tierra, perforación, izaje, servicios de apoyo minero y otras operaciones que necesitan ordenar activos, trabajo técnico e inventario.
          </p>
        </div>

        <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
          <h3 class="text-xl font-black">Beneficios para el trabajo diario</h3>
          <ul class="mt-5 grid gap-3">
            {benefits.map((benefit) => (
              <li class="rounded-xl border border-white/10 bg-white/5 px-4 py-3 font-semibold text-slate-100">{benefit}</li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <HomeFaqSection faqs={eamFaqs} contactHref="/contacto?producto=eam#formulario" contactLabel="Consultar EAM" />
    <ProductRelated current="eam" />
    <ContactBand title="Conversemos sobre tu operación" text="Cuéntanos qué activos, trabajos y procesos de abastecimiento necesitas organizar para preparar una propuesta ajustada a tu operación." primaryLabel="Cotizar EAM" primaryHref="/contacto?producto=eam#formulario" secondaryLabel="Enviar correo" whatsappMessage={contact.whatsappMessages.eam} />
  </main>
  <SiteFooter />
</Layout>
