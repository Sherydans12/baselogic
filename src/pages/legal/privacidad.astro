---
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import ListingHero from '../../components/ListingHero.astro';
import { seo } from '../../data/seo';
import { contact } from '../../data/contact';

const pageSeo = seo.privacy;
---

<Layout title={pageSeo.title} description={pageSeo.description} canonicalPath={pageSeo.path}>
  <SiteHeader />
  <main>
    <ListingHero
      eyebrow="Legal"
      title="Politica de privacidad"
      text="Informacion general sobre como BaseLogic trata los datos de contacto recibidos a traves del sitio y sus canales comerciales."
    />

    <section class="bg-white py-16">
      <div class="mx-auto max-w-4xl px-5 text-lg leading-8 text-slate-700 md:px-8">
        <h2 class="text-2xl font-black text-slate-950">1. Informacion que recopilamos</h2>
        <p class="mt-4">
          Podemos recopilar nombre, email, telefono, empresa, tipo de proyecto y mensaje cuando una persona solicita informacion, cotizacion o soporte.
        </p>

        <h2 class="mt-10 text-2xl font-black text-slate-950">2. Uso de la informacion</h2>
        <p class="mt-4">
          Usamos la informacion para responder solicitudes, preparar propuestas, coordinar reuniones, entregar soporte y mantener comunicacion relacionada con servicios o productos BaseLogic.
        </p>

        <h2 class="mt-10 text-2xl font-black text-slate-950">3. Cuidado de datos</h2>
        <p class="mt-4">
          No vendemos datos personales. Solo compartimos informacion con proveedores necesarios para operar formularios, correo, hosting, soporte o herramientas comerciales cuando corresponda.
        </p>

        <h2 class="mt-10 text-2xl font-black text-slate-950">4. Derechos y contacto</h2>
        <p class="mt-4">
          Puedes solicitar acceso, correccion o eliminacion de tus datos escribiendo a <a href={`mailto:${contact.email}`} class="font-bold text-brand-blue hover:underline">{contact.email}</a>.
        </p>
      </div>
    </section>
  </main>
  <SiteFooter />
</Layout>
