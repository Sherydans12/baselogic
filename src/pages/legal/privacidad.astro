---
import LegalDocument from '../../layouts/LegalDocument.astro';
import { seo } from '../../data/seo';

const sections = [
  {
    id: 'informacion-que-recopilamos',
    title: 'Información que recopilamos',
    text: 'Podemos recopilar nombre, correo electrónico, teléfono, empresa, tipo de proyecto y mensaje cuando una persona solicita información, cotización, evaluación técnica o soporte.',
  },
  {
    id: 'uso-de-la-informacion',
    title: 'Uso de la información',
    text: 'Usamos la información para responder solicitudes, preparar propuestas, coordinar reuniones, entregar soporte y mantener comunicación relacionada con los servicios o productos de BaseLogic.',
  },
  {
    id: 'resguardo-de-datos',
    title: 'Cuidado y resguardo de datos',
    text: 'No vendemos datos personales. Solo compartimos información con proveedores tecnológicos necesarios para operar formularios, correo electrónico, alojamiento o herramientas de gestión comercial cuando corresponda.',
  },
  {
    id: 'derechos-y-contacto',
    title: 'Derechos y contacto',
    text: 'Puedes solicitar acceso, rectificación o eliminación de tus datos escribiendo a',
    contactLink: true,
  },
];
---

<LegalDocument
  seo={seo.privacy}
  kind="privacy"
  title="Política de privacidad"
  intro="Información general sobre cómo BaseLogic (marca de SENAS TECNOLOGÍAS SpA) trata los datos de contacto recibidos a través del sitio y sus canales comerciales."
  sections={sections}
  related={{ href: seo.terms.path, label: 'Ver términos de servicio' }}
/>
