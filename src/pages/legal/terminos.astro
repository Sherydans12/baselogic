---
import LegalDocument from '../../layouts/LegalDocument.astro';
import { seo } from '../../data/seo';

const sections = [
  {
    id: 'alcance-y-propuestas',
    title: 'Alcance y propuestas comerciales',
    text: 'Cada proyecto, implementación o servicio se rige por una propuesta comercial o acuerdo específico donde se definen el alcance técnico, etapas, plazos estimados, entregables, valores y responsabilidades de ambas partes.',
  },
  {
    id: 'valores-y-servicios-externos',
    title: 'Valores referenciales y servicios externos',
    text: 'Los valores publicados en el sitio web son referenciales. El presupuesto definitivo puede variar según el alcance acordado, integraciones, soporte requerido y servicios externos tales como alojamiento (hosting), registro de dominios, cuentas de correo, pasarelas de pago o licencias de terceros.',
  },
  {
    id: 'soporte-y-continuidad',
    title: 'Soporte, continuidad y evolución',
    text: 'El soporte técnico, la mantención periódica y las mejoras o nuevos módulos posteriores a la entrega se definen según el plan contratado o el acuerdo específico vigente con cada cliente.',
  },
  {
    id: 'contacto',
    title: 'Contacto',
    text: 'Para consultas sobre estos términos puedes escribir a',
    contactLink: true,
  },
];
---

<LegalDocument
  seo={seo.terms}
  kind="terms"
  title="Términos de servicio"
  intro="Condiciones generales aplicables a propuestas, servicios, soporte y soluciones digitales entregadas por BaseLogic (marca de SENAS TECNOLOGÍAS SpA)."
  sections={sections}
  related={{ href: seo.privacy.path, label: 'Ver política de privacidad' }}
/>
