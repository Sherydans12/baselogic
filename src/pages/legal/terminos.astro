---
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import ListingHero from '../../components/ListingHero.astro';
import { seo } from '../../data/seo';
import { contact } from '../../data/contact';

const pageSeo = seo.terms;
---

<Layout title={pageSeo.title} description={pageSeo.description} canonicalPath={pageSeo.path}>
  <SiteHeader />
  <main>
    <ListingHero
      eyebrow="Legal"
      title="Terminos de servicio"
      text="Condiciones generales aplicables a propuestas, servicios, soporte y soluciones digitales entregadas por BaseLogic."
    />

    <section class="bg-white py-16">
      <div class="mx-auto max-w-4xl px-5 text-lg leading-8 text-slate-700 md:px-8">
        <h2 class="text-2xl font-black text-slate-950">1. Alcance</h2>
        <p class="mt-4">
          Cada proyecto se rige por una propuesta o acuerdo especifico donde se define alcance, plazos, entregables, valores y responsabilidades.
        </p>

        <h2 class="mt-10 text-2xl font-black text-slate-950">2. Pagos y servicios externos</h2>
        <p class="mt-4">
          Los valores pueden variar segun alcance, integraciones, soporte requerido y servicios externos como hosting, dominios, correos, pasarelas de pago o herramientas de terceros.
        </p>

        <h2 class="mt-10 text-2xl font-black text-slate-950">3. Soporte y cambios</h2>
        <p class="mt-4">
          El soporte, mantencion y cambios posteriores se definen segun el plan contratado o el acuerdo especifico de cada cliente.
        </p>

        <h2 class="mt-10 text-2xl font-black text-slate-950">4. Contacto</h2>
        <p class="mt-4">
          Para dudas sobre estos terminos puedes escribir a <a href={`mailto:${contact.email}`} class="font-bold text-brand-blue hover:underline">{contact.email}</a>.
        </p>
      </div>
    </section>
  </main>
  <SiteFooter />
</Layout>
