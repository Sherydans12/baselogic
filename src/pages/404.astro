---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
---

<Layout
  title="Página no encontrada | BaseLogic"
  description="La página solicitada no existe o fue movida. Puedes volver al inicio o cotizar tu proyecto digital con BaseLogic."
  robots="noindex, follow"
>
  <SiteHeader />
  <main class="commercial-surface">
    <section class="mx-auto flex min-h-[62vh] max-w-4xl flex-col items-center justify-center px-5 py-20 text-center md:px-8">
      <p class="text-sm font-bold uppercase tracking-wide text-brand-blue">Error 404</p>
      <h1 class="mt-4 text-4xl font-black tracking-tight text-slate-950 md:text-6xl">No encontramos esta página</h1>
      <p class="mt-5 max-w-2xl text-lg leading-8 text-slate-600">
        Es posible que el enlace haya cambiado. Puedes volver al inicio, revisar los servicios disponibles o escribirnos para orientar tu proyecto.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href="/" class="inline-flex justify-center rounded-full bg-brand-blue px-6 py-3.5 text-base font-bold text-white transition hover:bg-slate-950">
          Volver al inicio
        </a>
        <a href="/contacto" class="inline-flex justify-center rounded-full border border-slate-300 bg-white px-6 py-3.5 text-base font-bold text-slate-800 transition hover:border-brand-blue hover:text-brand-blue">
          Contactar a BaseLogic
        </a>
      </div>
    </section>
  </main>
  <SiteFooter />
</Layout>
