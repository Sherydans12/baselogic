---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ListingHero from '../components/ListingHero.astro';
import ContactOptions from '../components/ContactOptions.astro';
import LeadForm from '../components/LeadForm';
import { seo } from '../data/seo';
import { baseSchema } from '../data/schema';

const pageSeo = seo.contact;
const schema = baseSchema(pageSeo.description);
---

<Layout title={pageSeo.title} description={pageSeo.description} canonicalPath={pageSeo.path} schema={schema}>
  <SiteHeader />
  <main>
    <ListingHero
      eyebrow="Contacto"
      title="Cotiza tu proyecto digital"
      text="Cuéntanos que necesita tu negocio. Te ayudamos a ordenar la idea, elegir el mejor punto de partida y avanzar con una propuesta clara."
    />

    <section class="bg-slate-50 py-20">
      <div class="mx-auto grid max-w-7xl gap-8 px-5 md:px-8 lg:grid-cols-[1fr_0.75fr]">
        <LeadForm client:load />
        <ContactOptions />
      </div>
    </section>
  </main>
  <SiteFooter />
</Layout>
