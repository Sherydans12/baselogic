---
import { ArrowRight, Check, Code2, Globe2, Workflow } from 'lucide-react';
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import FinalCtaSection from '../../components/FinalCtaSection.astro';
import HomeFaqSection from '../../components/HomeFaqSection.astro';
import { services } from '../../data/services';
import { serviceVisuals } from '../../data/serviceVisuals';
import type { ServiceVisualId } from '../../data/serviceVisuals';
import { seo } from '../../data/seo';
import { generalFaqs } from '../../data/faqs';
import { contact } from '../../data/contact';
import { baseSchema, faqSchema } from '../../data/schema';

const pageSeo = seo.services;
const schema = [...baseSchema(pageSeo.description), faqSchema(generalFaqs)];
const groups = [
  {
    title: 'Presencia digital y captación',
    text: 'Para presentar tu empresa, comunicar una oferta y recibir consultas.',
    ids: ['paginas-web', 'landing-pages', 'wordpress', 'webs-estaticas'],
  },
  {
    title: 'Operación y continuidad',
    text: 'Para conectar herramientas, ordenar procesos y acompañar la evolución de tu plataforma.',
    ids: ['sistemas-para-pymes', 'automatizacion', 'soporte-digital'],
  },
];
---

<Layout title={pageSeo.title} description={pageSeo.description} canonicalPath={pageSeo.path} schema={schema} whatsappMessage={contact.whatsappMessages.services}>
  <SiteHeader />
  <main>
    <section class="border-b border-[#dce8f8] bg-[#f7faff] py-12 md:py-16">
      <div class="mx-auto grid max-w-7xl items-center gap-9 px-5 md:px-8 lg:grid-cols-[1fr_0.9fr] lg:gap-14">
        <div>
          <p class="inline-flex items-center gap-2 text-sm font-bold text-[#1558c6]">
            <Globe2 class="h-4 w-4" aria-hidden="true" />
            Servicios BaseLogic
          </p>
          <h1 class="mt-4 max-w-2xl text-3xl font-black leading-[1.1] tracking-[-0.03em] text-[#0b1a4c] sm:text-4xl xl:text-[2.9rem]">
            Tecnología para vender, ordenar y evolucionar
          </h1>
          <p class="mt-5 max-w-2xl text-base leading-relaxed text-[#405578] sm:text-lg">
            Desarrollamos páginas web, landing pages, sitios WordPress, sistemas a medida, automatización y continuidad digital con alcance claro y foco operacional.
          </p>
          <div class="mt-7 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <a href="#servicios-lista" class="group inline-flex min-h-12 items-center justify-center gap-2 rounded-xl bg-[#0964ef] px-5 py-3 text-sm font-bold text-white transition-colors hover:bg-[#064bb7] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#075be8]">
              Explorar servicios
              <ArrowRight class="h-4 w-4 transition-transform group-hover:translate-x-1" aria-hidden="true" />
            </a>
            <a href="/contacto#formulario" class="inline-flex min-h-12 items-center justify-center rounded-xl border border-[#c9daf1] bg-white px-5 py-3 text-sm font-bold text-[#0754c9] transition-colors hover:border-[#0964ef] hover:bg-[#edf5ff] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#075be8]">
              Hablemos de tu proyecto
            </a>
          </div>
        </div>

        <div class="overflow-hidden rounded-3xl border border-[#d9e7f8] bg-white shadow-[0_18px_45px_-32px_rgba(16,74,170,0.4)]">
          <div class="aspect-[3/2] overflow-hidden bg-[#edf5ff]">
            <img src="/images/servicios/espacio-tecnologico-dashboard.webp" alt="Espacio de trabajo con un dashboard en un computador portátil y herramientas digitales conectadas." width="1536" height="1024" fetchpriority="high" decoding="async" class="h-full w-full object-cover" />
          </div>
          <div class="grid grid-cols-2 gap-4 px-5 py-5 sm:px-6">
            <div class="flex items-center gap-3">
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-[#eaf2ff] text-[#0964ef]"><Globe2 class="h-5 w-5" aria-hidden="true" /></span>
              <span class="text-sm font-bold leading-snug text-[#0b1a4c]">Presencia digital</span>
            </div>
            <div class="flex items-center gap-3">
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-[#eaf2ff] text-[#0964ef]"><Workflow class="h-5 w-5" aria-hidden="true" /></span>
              <span class="text-sm font-bold leading-snug text-[#0b1a4c]">Procesos conectados</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="servicios-lista" class="scroll-mt-24 bg-white py-14 md:py-16">
      <div class="mx-auto max-w-7xl px-5 md:px-8">
        <div class="grid gap-4 lg:grid-cols-[1fr_0.8fr] lg:items-end lg:gap-12">
          <h2 class="text-3xl font-black tracking-[-0.03em] text-[#0b1a4c] sm:text-4xl">Elige un punto de partida</h2>
          <p class="max-w-xl text-base leading-relaxed text-[#405578]">Si aún no tienes claro qué necesitas, podemos orientarte desde el problema que quieres resolver.</p>
        </div>

        {groups.map((group) => (
          <section class="mt-10" aria-labelledby={`group-${group.ids[0]}`}>
            <div class="flex flex-col gap-2 border-b border-[#dce8f8] pb-4 sm:flex-row sm:items-end sm:justify-between sm:gap-6">
              <h3 id={`group-${group.ids[0]}`} class="text-xl font-extrabold tracking-[-0.02em] text-[#0b1a4c]">{group.title}</h3>
              <p class="max-w-xl text-sm leading-relaxed text-[#405578]">{group.text}</p>
            </div>
            <div class:list={['mt-5 grid gap-4 sm:grid-cols-2', group.ids.length === 4 ? 'xl:grid-cols-4' : 'xl:grid-cols-3']}>
              {services.filter((service) => group.ids.includes(service.id)).map((service) => {
                const visual = serviceVisuals[service.id as ServiceVisualId];
                const ServiceIcon = visual.icon;
                return (
                  <article class="group flex min-w-0 flex-col overflow-hidden rounded-2xl border border-[#dce8f8] bg-white transition-colors hover:border-[#9fc5f8]">
                    <div>
                      <img
                        src={visual.image}
                        alt=""
                        aria-hidden="true"
                        width={visual.imageStyle === 'photo' ? 1376 : 1671}
                        height={visual.imageStyle === 'photo' ? 768 : 941}
                        loading="lazy"
                        decoding="async"
                        class="block h-auto w-full"
                      />
                    </div>
                    <div class="flex min-w-0 flex-1 flex-col p-5">
                      <div class="flex items-start gap-3">
                        <ServiceIcon class="mt-0.5 h-5 w-5 shrink-0 text-[#0964ef]" aria-hidden="true" />
                        <div>
                          <h4 class="text-lg font-extrabold leading-snug tracking-[-0.02em] text-[#0b1a4c]">{service.title}</h4>
                          <p class="mt-2 text-sm leading-relaxed text-[#405578]">{service.summary}</p>
                        </div>
                      </div>
                      <ul class="mt-4 flex flex-wrap gap-x-4 gap-y-2 text-xs font-semibold text-[#315078]">
                        {service.benefits.slice(0, 3).map((benefit) => (
                          <li class="inline-flex items-center gap-1.5"><Check class="h-3.5 w-3.5 text-[#0964ef]" aria-hidden="true" />{benefit}</li>
                        ))}
                      </ul>
                      <a href={service.href} aria-label={`Conocer ${service.title}`} class="mt-auto inline-flex min-h-10 w-fit items-center gap-2 pt-5 text-sm font-bold text-[#0754c9] transition-colors hover:text-[#0b1a4c] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#075be8]">
                        Conocer servicio
                        <ArrowRight class="h-4 w-4 transition-transform group-hover:translate-x-1" aria-hidden="true" />
                      </a>
                    </div>
                  </article>
                );
              })}
            </div>
          </section>
        ))}
      </div>
    </section>

    <section class="bg-[#f1f6ff] py-12 md:py-14">
      <div class="mx-auto grid max-w-7xl gap-6 px-5 md:px-8 lg:grid-cols-[auto_1fr_auto] lg:items-center lg:gap-8">
        <span class="flex h-14 w-14 items-center justify-center rounded-2xl bg-white text-[#0964ef]"><Code2 class="h-7 w-7" aria-hidden="true" /></span>
        <div>
          <h2 class="text-2xl font-extrabold tracking-[-0.025em] text-[#0b1a4c]">¿Tu proyecto necesita algo a medida?</h2>
          <p class="mt-2 max-w-2xl text-base leading-relaxed text-[#405578]">Podemos revisar tu situación, definir prioridades y proponer una primera etapa acorde a tu operación.</p>
        </div>
        <a href="/contacto#formulario" class="group inline-flex min-h-12 w-fit items-center gap-2 rounded-xl bg-[#0964ef] px-5 py-3 text-sm font-bold text-white transition-colors hover:bg-[#064bb7] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#075be8]">
          Cuéntanos tu idea
          <ArrowRight class="h-4 w-4 transition-transform group-hover:translate-x-1" aria-hidden="true" />
        </a>
      </div>
    </section>

    <HomeFaqSection faqs={generalFaqs} showContactCard={false} />
    <FinalCtaSection />
  </main>
  <SiteFooter />
</Layout>
