---
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import ListingHero from '../../components/ListingHero.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import FinalCtaSection from '../../components/FinalCtaSection.astro';
import FaqBlock from '../../components/FaqBlock.astro';
import { services } from '../../data/services';
import { seo } from '../../data/seo';
import { generalFaqs } from '../../data/faqs';
import { contact } from '../../data/contact';
import { baseSchema, faqSchema } from '../../data/schema';

const pageSeo = seo.services;
const schema = [...baseSchema(pageSeo.description), faqSchema(generalFaqs)];
---

<Layout title={pageSeo.title} description={pageSeo.description} canonicalPath={pageSeo.path} schema={schema} whatsappMessage={contact.whatsappMessages.services}>
  <SiteHeader />
  <main>
    <ListingHero
      eyebrow="Servicios"
      title="Servicios digitales y sistemas para empresas que necesitan vender, ordenar y evolucionar"
      text="Desarrollamos páginas web, landing pages, sitios WordPress, sistemas a medida, automatización y continuidad digital con alcance claro y foco operacional."
    />

    <section class="bg-white py-20">
      <div class="mx-auto max-w-7xl px-5 md:px-8">
        <SectionHeading
          title="Elige un punto de partida"
          text="Si no tienes claro qué necesitas, podemos orientarte desde el problema: presencia digital, reservas, pagos, inventario, automatización o soporte continuo."
        />
        <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          {services.map((service) => (
            <article class="rounded-2xl border border-slate-200 bg-slate-50 p-6">
              <h2 class="text-2xl font-black text-slate-950">{service.title}</h2>
              <p class="mt-3 leading-7 text-slate-600">{service.summary}</p>
              <ul class="mt-5 space-y-2 text-sm text-slate-700">
                {service.benefits.map((benefit) => (
                  <li class="flex gap-2">
                    <span class="mt-2 h-1.5 w-1.5 rounded-full bg-brand-cyan"></span>
                    {benefit}
                  </li>
                ))}
              </ul>
              <a href={service.href} class="mt-6 inline-flex rounded-full bg-white px-4 py-2 text-sm font-bold text-brand-blue ring-1 ring-slate-200 hover:ring-brand-cyan">
                Cotizar o conocer más
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <FaqBlock faqs={generalFaqs} />
    <FinalCtaSection />
  </main>
  <SiteFooter />
</Layout>
