---
import { ArrowRight, Building2, Stethoscope, GraduationCap, HardHat, Store, Briefcase } from 'lucide-react';
import { industries } from '../data/industries';
import { visualAssets } from '../data/visualAssets';

const sectorIcons = [
  Stethoscope, // Salud y Centros Médicos
  Briefcase,   // Servicios Profesionales
  GraduationCap, // Educación y Colegios
  HardHat,     // Minería y Operaciones
  Store,       // Comercio y Pymes
  Building2,   // Empresas y Consultoras
];
---

<section class="relative overflow-hidden bg-slate-950 py-14 md:py-18 text-white">
  <!-- Full Real Commerce Background Photo (Hardware Accelerated 60 FPS) -->
  <div class="absolute inset-0 z-0 overflow-hidden transform-gpu">
    <img
      src={visualAssets.home.realCommerceBg.src}
      alt={visualAssets.home.realCommerceBg.alt}
      loading="lazy"
      decoding="async"
      class="h-full w-full object-cover object-center filter brightness-[0.7] saturate-[1.05]"
    />
    <!-- Light Dark Gradient Overlay (Zero GPU backdrop-filter load) -->
    <div class="absolute inset-0 bg-gradient-to-b from-slate-950/80 via-slate-950/60 to-slate-950/85"></div>
  </div>

  <div class="mx-auto max-w-7xl px-5 md:px-8 relative z-10">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-5 mb-8">
      <div class="max-w-2xl">
        <span class="inline-flex items-center gap-1.5 rounded-full border border-brand-cyan/40 bg-slate-900/90 px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-brand-cyan shadow-sm">
          Soluciones por rubro en Chile
        </span>
        <h2 class="mt-3 text-2xl font-black tracking-tight text-white md:text-4xl leading-tight">
          Adaptamos la solución a la realidad de tu industria
        </h2>
        <p class="mt-2 text-sm leading-relaxed text-slate-200 md:text-base">
          No todos los negocios operan igual. Diseñamos e implementamos según la forma real en que atiendes a tus clientes y gestionas tus procesos.
        </p>
      </div>

      <div class="shrink-0">
        <a
          href="/casos-de-exito"
          class="inline-flex items-center gap-2 rounded-full bg-white px-5 py-3 text-sm font-bold text-slate-950 shadow-md transition-all duration-200 hover:bg-brand-cyan hover:shadow-cyan-500/20 hover:-translate-y-0.5"
        >
          Explorar casos de uso
          <ArrowRight class="h-4 w-4" />
        </a>
      </div>
    </div>

    <!-- Fast 60 FPS Performance Cards Grid -->
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {industries.map((industry, index) => {
        const Icon = sectorIcons[index % sectorIcons.length];
        const isLastSingle = index === industries.length - 1 && industries.length % 3 === 1;
        return (
          <article
            class:list={[
              'group relative overflow-hidden rounded-2xl border border-white/15 bg-slate-900/85 p-5 transition-all duration-200 hover:border-brand-cyan/50 hover:bg-slate-900/95 hover:shadow-lg hover:shadow-cyan-500/10',
              isLastSingle ? 'sm:col-span-2 lg:col-span-1 lg:col-start-2' : '',
            ]}
          >
            <div class="flex items-center gap-3.5">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-white/10 text-brand-cyan transition-colors group-hover:bg-brand-cyan group-hover:text-slate-950">
                <Icon class="h-5 w-5" />
              </div>
              <h3 class="text-base font-bold text-white leading-snug">{industry.name}</h3>
            </div>

            <p class="mt-3 text-xs leading-relaxed text-slate-300">{industry.need}</p>
          </article>
        );
      })}
    </div>
  </div>
</section>
