---
import { industries } from '../data/industries';
---

<section class="bg-slate-950 py-20 text-white">
  <div class="mx-auto max-w-7xl px-5 md:px-8">
    <div class="mb-10 max-w-3xl">
      <p class="mb-3 text-sm font-bold uppercase tracking-wide text-brand-cyan">Soluciones por rubro</p>
      <h2 class="text-3xl font-bold tracking-tight text-white md:text-4xl">Adaptamos la solucion al tipo de negocio</h2>
      <p class="mt-4 text-lg leading-8 text-slate-300">
        No todos los negocios necesitan lo mismo. Por eso partimos desde el rubro, el proceso y la forma real en que atiendes a tus clientes.
      </p>
    </div>
    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {industries.map((industry) => (
        <article class="rounded-2xl border border-white/10 bg-white/5 p-5">
          <h3 class="text-lg font-bold text-white">{industry.name}</h3>
          <p class="mt-3 leading-7 text-slate-300">{industry.need}</p>
        </article>
      ))}
    </div>
    <div class="mt-8">
      <a href="/casos-de-exito" class="inline-flex rounded-full bg-white px-6 py-3 text-sm font-bold text-slate-950 transition hover:bg-brand-cyan">
        Ver casos de uso
      </a>
    </div>
  </div>
</section>
