---
import { ArrowRight } from 'lucide-react';
import { caseStudies } from '../data/caseStudies';
import { serviceProcess } from '../data/services';

const featuredScenarios = caseStudies.slice(0, 4);
---

<section
  id="soluciones-y-metodo"
  aria-labelledby="soluciones-metodo-heading"
  class="border-b border-slate-200 bg-slate-50 py-16 md:py-20"
>
  <div class="mx-auto max-w-7xl px-5 md:px-8">
    <div class="flex flex-col justify-between gap-4 border-b border-slate-200 pb-8 lg:flex-row lg:items-end">
      <div class="max-w-3xl">
        <span class="font-mono text-xs font-bold uppercase tracking-wider text-brand-blue">
          05 / ESCENARIOS POR RUBRO Y METODOLOGÍA DE TRABAJO
        </span>
        <h2 id="soluciones-metodo-heading" class="mt-2 text-2xl font-black tracking-tight text-slate-950 md:text-4xl">
          Aplicación práctica por industria y ejecución estructurada por etapas
        </h2>
      </div>
      <div class="shrink-0">
        <a
          href="/casos-de-exito"
          class="inline-flex items-center gap-2 rounded-full border border-slate-300 bg-white px-5 py-2.5 text-sm font-bold text-slate-800 transition hover:border-brand-blue hover:text-brand-blue"
        >
          Ver todos los escenarios por rubro
          <ArrowRight class="h-4 w-4" />
        </a>
      </div>
    </div>

    <div class="mt-10 grid gap-8 lg:grid-cols-[1.15fr_0.85fr]">
      <!-- Columna Izquierda: Escenarios Representativos -->
      <div>
        <div class="mb-4 flex items-center justify-between">
          <h3 class="font-mono text-xs font-bold uppercase tracking-wider text-slate-600">
            Escenarios de aplicación representativos (No clientes nominales)
          </h3>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          {featuredScenarios.map((scenario) => (
            <article class="flex flex-col justify-between rounded-2xl border border-slate-200 bg-white p-5 shadow-2xs">
              <div>
                <span class="inline-block rounded border border-slate-200 bg-slate-50 px-2.5 py-0.5 font-mono text-[10px] font-semibold text-slate-600">
                  {scenario.label}
                </span>
                <h4 class="mt-2.5 text-base font-black text-slate-950">{scenario.title}</h4>
                <p class="mt-2 text-xs leading-5 text-slate-600">
                  <strong class="font-semibold text-slate-800">Problema habitual:</strong> {scenario.problem}
                </p>
                <p class="mt-2 text-xs leading-5 text-slate-600">
                  <strong class="font-semibold text-brand-blue">Enfoque BaseLogic:</strong> {scenario.solution}
                </p>
              </div>
              <div class="mt-4 border-t border-slate-100 pt-3">
                <a
                  href={scenario.relatedHref}
                  class="inline-flex items-center gap-1 text-xs font-bold text-brand-blue hover:text-slate-950"
                >
                  {scenario.relatedLabel}
                  <ArrowRight class="h-3.5 w-3.5" />
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>

      <!-- Columna Derecha: Metodología en 4 Etapas -->
      <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-2xs">
        <span class="font-mono text-xs font-bold uppercase tracking-wider text-brand-blue">
          Criterio de ingeniería · Sin promesas irreales
        </span>
        <h3 class="mt-1.5 text-xl font-black text-slate-950">
          Cómo planificamos y ejecutamos cada proyecto
        </h3>
        <p class="mt-2 text-xs leading-5 text-slate-600">
          Reemplazamos los plazos universales arbitrarios por una planificación realista basada en el alcance técnico de tu requerimiento.
        </p>

        <ol class="mt-5 space-y-3.5">
          {serviceProcess.map((step, index) => (
            <li class="flex items-start gap-3.5 rounded-xl border border-slate-200/80 bg-slate-50/70 p-3.5">
              <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-brand-blue font-mono text-xs font-bold text-white">
                0{index + 1}
              </span>
              <div>
                <h4 class="text-sm font-bold text-slate-950">{step.title}</h4>
                <p class="mt-1 text-xs leading-5 text-slate-600">{step.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </div>
</section>
