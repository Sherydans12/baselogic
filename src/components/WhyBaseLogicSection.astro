---
import { CheckCircle2 } from 'lucide-react';
import SectionHeading from './SectionHeading.astro';
import { home } from '../data/home';
---

<section class="bg-slate-50 py-20">
  <div class="mx-auto max-w-7xl px-5 md:px-8">
    <SectionHeading
      eyebrow="Por que BaseLogic"
      title="Tecnologia moderna explicada en simple"
      text="Nos importa que entiendas que se esta construyendo, por que sirve y como puede crecer sin volverse innecesariamente complejo."
    />
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {home.why.map((item) => (
        <div class="flex items-center gap-3 rounded-2xl border border-slate-200 bg-white p-5">
          <CheckCircle2 class="h-5 w-5 text-brand-blue" />
          <span class="font-bold text-slate-800">{item}</span>
        </div>
      ))}
    </div>
  </div>
</section>
