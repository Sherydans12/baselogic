---
import { ArrowUpRight } from 'lucide-react';
import type { CaseStudy } from '../data/caseStudies';

type Props = CaseStudy;

const { id, title, sector, problem, solution, expectedResult, relatedHref, relatedLabel } = Astro.props;
---

<article id={id} aria-labelledby={`${id}-titulo`} class="case-study">
  <header>
    <h2 id={`${id}-titulo`} class="interior-heading">{title}</h2>
    <p class="case-study__sector">{sector}</p>
  </header>

  <dl class="case-study__details">
    <div>
      <dt>Problema</dt>
      <dd>{problem}</dd>
    </div>
    <div>
      <dt>Solución propuesta</dt>
      <dd>{solution}</dd>
    </div>
    <div>
      <dt>Resultado esperado</dt>
      <dd>{expectedResult}</dd>
    </div>
  </dl>

  <div class="case-study__action">
    <a href={relatedHref} class="interior-link">
      {relatedLabel}
      <ArrowUpRight width={17} height={17} aria-hidden="true" />
    </a>
  </div>
</article>

<style>
  .case-study {
    display: grid;
    grid-template-areas: 'title' 'details' 'action';
    gap: 1.25rem;
    border-bottom: 1px solid var(--interior-border);
    padding-block: clamp(1.75rem, 4.5vw, 3.625rem);
  }

  .case-study header {
    grid-area: title;
  }

  .case-study h2 {
    max-width: 21ch;
    text-wrap: pretty;
  }

  .case-study:target h2,
  .case-study__sector {
    color: var(--interior-link);
  }

  .case-study__sector {
    margin-top: 0.625rem;
    font-size: 0.875rem;
    font-weight: 700;
  }

  .case-study__details {
    grid-area: details;
  }

  .case-study__details div {
    display: grid;
    gap: 0.375rem;
    border-top: 1px solid var(--interior-border);
    padding: 0.875rem 0;
  }

  .case-study__details div:last-child {
    border-radius: 0 0 0.75rem 0.75rem;
    padding-inline: 0.875rem;
    background: var(--interior-ice);
  }

  .case-study__details dt {
    font-size: 0.875rem;
    font-weight: 750;
  }

  .case-study__details dd {
    color: var(--interior-copy);
    line-height: 1.65;
  }

  .case-study__action {
    grid-area: action;
    font-size: 0.9375rem;
  }

  @media (min-width: 48rem) {
    .case-study {
      grid-template: 'title details' auto 'action details' 1fr / minmax(0, 0.85fr) minmax(0, 1.15fr);
      align-items: start;
      column-gap: clamp(2rem, 5vw, 5rem);
    }
  }

  @media (min-width: 64rem) {
    .case-study__details div {
      grid-template-columns: 8.75rem minmax(0, 1fr);
      gap: 0.875rem;
      padding-inline: 0.875rem;
    }

    .case-study__details dt {
      padding-top: 0.1875rem;
    }
  }
</style>
