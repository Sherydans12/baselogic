---
import { ArrowRight, CheckCircle2, Code2, Cpu, LayoutGrid, Zap } from 'lucide-react';
import SectionHeading from './SectionHeading.astro';
import { services } from '../data/services';
---

<section class="bg-slate-50/80 py-20 md:py-28 border-b border-slate-200/80">
  <div class="mx-auto max-w-7xl px-5 md:px-8">
    <SectionHeading
      eyebrow="Servicios principales"
      title="Servicios para partir claro y crecer con orden"
      text="Desde una web profesional de alta conversión hasta un sistema a medida para administrar tu pyme sin complicaciones."
    />

    <!-- Bento Grid Container -->
    <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {services.map((service, index) => {
        const isWide = index === 0 || index === 3;
        return (
          <article
            class:list={[
              'group relative flex flex-col justify-between overflow-hidden rounded-3xl border border-slate-200/80 bg-white p-7 shadow-xs transition-all duration-300 hover:-translate-y-1 hover:border-brand-blue/30 hover:shadow-xl hover:shadow-slate-900/10',
              isWide ? 'lg:col-span-2' : 'col-span-1',
            ]}
          >
            <!-- Decorative Gradient Glow on Hover -->
            <div class="pointer-events-none absolute -right-10 -top-10 h-40 w-40 rounded-full bg-cyan-400/10 blur-2xl opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div>

            <div>
              <div class="flex items-center justify-between">
                <span class="inline-flex items-center gap-1.5 rounded-full border border-blue-100 bg-blue-50/80 px-3 py-1 text-xs font-bold text-brand-blue">
                  {service.tag}
                </span>
                <span class="text-xs font-semibold text-slate-400">0{index + 1}</span>
              </div>

              <h3 class="mt-4 text-2xl font-bold text-slate-950">{service.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-slate-600">{service.summary}</p>

              <!-- Benefit Checklist -->
              <ul class="mt-6 space-y-2 border-t border-slate-100 pt-4 text-xs font-medium text-slate-700">
                {service.benefits.slice(0, 3).map((benefit) => (
                  <li class="flex items-center gap-2">
                    <CheckCircle2 class="h-4 w-4 text-emerald-500 shrink-0" />
                    <span>{benefit}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="mt-8 pt-2">
              <a
                href={service.href}
                class="inline-flex items-center gap-2 text-sm font-bold text-brand-blue transition-all duration-200 group-hover:translate-x-1 group-hover:text-slate-950"
              >
                Ver detalle de servicio
                <ArrowRight class="h-4 w-4" />
              </a>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>
