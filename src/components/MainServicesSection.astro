---
import { ArrowRight } from 'lucide-react';
import SectionHeading from './SectionHeading.astro';
import { services } from '../data/services';
---

<section class="bg-slate-50 py-20">
  <div class="mx-auto max-w-7xl px-5 md:px-8">
    <SectionHeading
      eyebrow="Servicios principales"
      title="Servicios para partir claro y crecer con orden"
      text="Desde una web profesional hasta un sistema simple para administrar reservas, clientes, pagos o inventario."
    />
    <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {services.map((service) => (
        <article class="flex min-h-[240px] flex-col rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
          <h3 class="text-xl font-bold text-slate-950">{service.title}</h3>
          <p class="mt-3 flex-1 leading-7 text-slate-600">{service.summary}</p>
          <ul class="mt-5 grid gap-2 text-sm text-slate-600">
            {service.benefits.slice(0, 3).map((benefit) => (
              <li class="flex items-center gap-2">
                <span class="h-1.5 w-1.5 rounded-full bg-brand-cyan"></span>
                {benefit}
              </li>
            ))}
          </ul>
          <a href={service.href} class="mt-6 inline-flex items-center gap-2 text-sm font-bold text-brand-blue hover:text-slate-950">
            Ver servicio
            <ArrowRight class="h-4 w-4" />
          </a>
        </article>
      ))}
    </div>
  </div>
</section>
