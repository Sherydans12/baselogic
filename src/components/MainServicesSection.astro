---
/**
 * MainServicesSection.astro
 * Sección 4 de la Home: Nuestros Servicios (Presencia digital, Automatización de procesos, Desarrollo de software).
 */
import { Check, Code2, Monitor, Settings2 } from 'lucide-react';

const servicePillars = [
  {
    title: 'Presencia digital',
    description:
      'Sitios web profesionales que comunican con claridad, convierten visitas en oportunidades y se integran con tu operación.',
    icon: Monitor,
    items: [
      'Sitios corporativos y comerciales a medida',
      'Landing pages orientadas a captación',
      'Integración de formularios, analítica y contacto',
    ],
  },
  {
    title: 'Automatización de procesos',
    description:
      'Conectamos tus herramientas, eliminamos tareas manuales repetitivas y ordenamos el flujo de información de tu equipo.',
    icon: Settings2,
    items: [
      'Automatizaciones operativas a medida',
      'Integración entre sistemas y plataformas',
      'Alertas, reportes y flujos de trabajo claros',
    ],
  },
  {
    title: 'Desarrollo de software',
    description:
      'Construimos sistemas web a medida y plataformas propias para resolver desafíos reales de gestión y operación.',
    icon: Code2,
    items: [
      'Sistemas web, portales y paneles internos',
      'Integraciones mediante APIs con terceros',
      'Arquitectura escalable y acompañamiento continuo',
    ],
  },
];
---

<section id="servicios" class="bg-white py-16 md:py-22 border-b border-slate-200/70">
  <div class="mx-auto max-w-7xl px-5 md:px-8">
    <div class="grid items-end gap-6 lg:grid-cols-[1.15fr_0.85fr]">
      <div>
        <p class="text-[11px] font-extrabold uppercase tracking-[0.2em] text-slate-500">
          Nuestros servicios
        </p>
        <h2 class="mt-2.5 text-3xl font-black leading-[1.1] tracking-tight text-slate-950 md:text-4xl">
          Tecnología para una operación más simple y conectada
        </h2>
      </div>
      <p class="text-base leading-relaxed text-slate-600 lg:pb-1">
        Desde la presencia digital hasta sistemas empresariales complejos, te acompañamos en todo el ciclo de evolución tecnológica de tu organización.
      </p>
    </div>

    <div class="mt-12 grid divide-y divide-slate-200/80 lg:grid-cols-3 lg:divide-x lg:divide-y-0">
      {
        servicePillars.map((pillar, idx) => {
          const Icon = pillar.icon;
          const paddingClass =
            idx === 0
              ? 'pb-8 lg:pb-0 lg:pr-8'
              : idx === 1
                ? 'py-8 lg:py-0 lg:px-8'
                : 'pt-8 lg:pt-0 lg:pl-8';
          return (
            <div class={paddingClass}>
              <div class="flex items-start gap-4">
                <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-blue-50 text-brand-blue ring-1 ring-blue-100">
                  <Icon class="h-6 w-6" />
                </div>
                <div>
                  <h3 class="text-lg font-black tracking-tight text-slate-950">
                    {pillar.title}
                  </h3>
                  <p class="mt-2 text-sm leading-relaxed text-slate-600">
                    {pillar.description}
                  </p>
                </div>
              </div>

              <ul class="mt-5 space-y-2.5 pl-1">
                {pillar.items.map((item) => (
                  <li class="flex items-center gap-2.5 text-sm font-medium text-slate-700">
                    <Check class="h-4 w-4 shrink-0 text-brand-blue" />
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          );
        })
      }
    </div>
  </div>
</section>
