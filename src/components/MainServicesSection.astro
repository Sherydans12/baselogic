---
/**
 * MainServicesSection.astro
 * Servicios principales de BaseLogic, presentados en tres pilares visuales.
 */
import { ArrowUpRight, Check } from 'lucide-react';

const servicePillars = [
  {
    title: 'Presencia digital',
    description:
      'Sitios web profesionales que comunican con claridad, convierten visitas en oportunidades y se integran con tu operación.',
    items: [
      'Sitios corporativos y comerciales a medida',
      'Landing pages orientadas a captación',
      'Integración de formularios, analítica y contacto',
    ],
    image: '/assets/servicios/presencia-digital.webp',
    imageAlt: 'Ilustración de una página web profesional en construcción',
    imageWidth: 442,
    icon: '/assets/servicios/icono-presencia-digital.svg',
    href: '/servicios/paginas-web',
  },
  {
    title: 'Automatización de procesos',
    description:
      'Conectamos tus herramientas, eliminamos tareas manuales repetitivas y ordenamos el flujo de información de tu equipo.',
    items: [
      'Automatizaciones operativas a medida',
      'Integración entre sistemas y plataformas',
      'Alertas, reportes y flujos de trabajo claros',
    ],
    image: '/assets/servicios/automatizacion-procesos.webp',
    imageAlt: 'Ilustración de un proceso automatizado que conecta herramientas y tareas',
    imageWidth: 441,
    icon: '/assets/servicios/icono-automatizacion.svg',
    href: '/servicios/automatizacion',
  },
  {
    title: 'Desarrollo de software',
    description:
      'Construimos sistemas web a medida y plataformas propias para resolver desafíos reales de gestión y operación.',
    items: [
      'Sistemas web, portales y paneles internos',
      'Integraciones mediante APIs con terceros',
      'Arquitectura escalable y acompañamiento continuo',
    ],
    image: '/assets/servicios/desarrollo-software.webp',
    imageAlt: 'Ilustración de desarrollo de software e integración mediante API',
    imageWidth: 454,
    icon: '/assets/servicios/icono-desarrollo.svg',
    href: '/servicios/sistemas-para-pymes',
  },
];
---

<section
  id="servicios"
  aria-labelledby="services-heading"
  class="bl-home-section bl-home-section--white scroll-mt-20"
>
  <div class="services-section-background pointer-events-none absolute inset-0" aria-hidden="true"></div>

  <div class="bl-home-section__container">
    <header class="bl-home-section__header" data-motion-reveal>
      <div>
        <p class="bl-home-section__eyebrow">Nuestros servicios</p>
        <h2 id="services-heading" class="bl-home-section__title">
          Tecnología para una operación más <span class="text-brand-blue">simple y conectada</span>
        </h2>
      </div>

      <p class="bl-home-section__lede">
        Desde la presencia digital hasta sistemas empresariales complejos, te acompañamos en todo el ciclo de evolución tecnológica de tu organización.
      </p>
    </header>

    <div class="service-cards-grid mt-7 grid items-stretch gap-4 md:grid-cols-2 lg:grid-cols-3 xl:gap-5">
      {servicePillars.map((pillar, index) => (
        <a
          href={pillar.href}
          aria-label={`Conocer el servicio: ${pillar.title}`}
          data-motion-reveal
          style={`--home-motion-delay: ${index * 60}ms`}
          class="bl-home-card bl-home-card--interactive service-card group relative flex min-w-0 flex-col overflow-hidden bg-white/90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#075be8]"
        >
          <span
            class="pointer-events-none absolute inset-x-0 top-0 z-10 h-[3px] origin-left scale-x-0 bg-gradient-to-r from-[#13c8e9] via-[#1762f5] to-[#13c8e9] opacity-0 transition-[transform,opacity] duration-400 ease-out group-hover:scale-x-100 group-hover:opacity-100 group-focus-visible:scale-x-100 group-focus-visible:opacity-100"
            aria-hidden="true"
          ></span>
          <img
            src={pillar.image}
            alt={pillar.imageAlt}
            width={pillar.imageWidth}
            height="225"
            loading="lazy"
            decoding="async"
            class="service-card-image block aspect-[2.1] w-full object-cover"
          />

          <div class="flex flex-1 flex-col p-5 sm:p-5 lg:p-5">
            <div class="flex items-start gap-3">
              <span class="service-card-icon flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl border border-[#dce8f8] bg-[#f5f9ff]">
                <img
                  src={pillar.icon}
                  alt=""
                  aria-hidden="true"
                  width="64"
                  height="64"
                  loading="lazy"
                  decoding="async"
                  class="h-10 w-10"
                />
              </span>
              <div class="min-w-0 flex-1 pt-1">
                <div class="flex items-start justify-between gap-2">
                  <h3 class="service-card-title text-xl font-extrabold leading-[1.15] tracking-[-0.025em] text-[#101b3d] sm:text-[1.375rem]">
                    {pillar.title}
                  </h3>
                  <ArrowUpRight class="service-card-arrow mt-0.5 h-4 w-4 shrink-0 text-[#075be8] transition-transform duration-300 ease-out group-hover:-translate-y-0.5 group-hover:translate-x-0.5" aria-hidden="true" />
                </div>
              </div>
            </div>

            <p class="mt-3 text-[0.95rem] leading-relaxed text-[#243454] sm:text-base">
              {pillar.description}
            </p>

            <ul class="mt-4 space-y-2.5">
              {pillar.items.map((item) => (
                <li class="flex items-start gap-3 text-[0.95rem] font-medium leading-[1.4] text-[#182544] sm:text-[0.95rem]">
                  <Check class="mt-0.5 h-5 w-5 shrink-0 stroke-[2.5] text-[#101b3d]" aria-hidden="true" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .services-section-background {
    background-image: url('/assets/servicios/fondo-blanco-sutil.svg');
    background-position: center 42%;
    background-repeat: no-repeat;
    background-size: cover;
  }

  .service-card {
    transition:
      transform 440ms cubic-bezier(0.2, 0.8, 0.2, 1),
      border-color 340ms ease-out,
      box-shadow 440ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .service-card-image {
    transform: scale(1);
    transition: transform 560ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .service-card-icon {
    box-shadow: 0 6px 16px -13px rgb(17 74 170 / 55%);
    transition:
      transform 360ms cubic-bezier(0.2, 0.8, 0.2, 1),
      border-color 300ms ease-out,
      background-color 300ms ease-out,
      box-shadow 360ms ease-out;
  }

  .service-card-title {
    transition: color 300ms ease-out;
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .service-card:hover,
    .service-card:focus-visible {
      transform: translate3d(0, -5px, 0);
      border-color: #a9ccff;
      box-shadow: 0 24px 46px -30px rgb(16 74 170 / 48%);
    }

    .service-card:hover .service-card-image,
    .service-card:focus-visible .service-card-image {
      transform: scale(1.035);
    }

    .service-card:hover .service-card-icon,
    .service-card:focus-visible .service-card-icon {
      transform: translate3d(0, -2px, 0);
      border-color: #b5d8ff;
      background-color: #eaf6ff;
      box-shadow: 0 10px 20px -14px rgb(0 111 230 / 65%);
    }

    .service-card:hover .service-card-title,
    .service-card:focus-visible .service-card-title {
      color: #075be8;
    }
  }

  @media (min-width: 768px) and (max-width: 1023px) {
    .service-cards-grid > .service-card:last-child {
      grid-column: 1 / -1;
      justify-self: center;
      width: calc((100% - 1.25rem) / 2);
    }
  }

</style>
