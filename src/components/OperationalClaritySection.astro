---
/**
 * OperationalClaritySection.astro
 * Sección 3 de la Home: Contraste visual directo Antes / Ahora
 * («Del desorden manual a la claridad operacional — Menos caos. Más control.»).
 */
import { Check, ChevronRight, Sparkles, X } from 'lucide-react';

const beforeItems = [
  'Información dispersa en múltiples planillas',
  'Tareas manuales y repetitivas todos los días',
  'Falta de trazabilidad sobre cobros, stock o equipos',
  'Errores operativos y reprocesos constantes',
  'Decisiones tomadas sin datos actualizados',
];

const afterItems = [
  'Procesos automatizados y flujos claros',
  'Información centralizada en una sola plataforma',
  'Trazabilidad operativa de punta a punta',
  'Menos errores y mayor control del equipo',
  'Decisiones respaldadas por indicadores reales',
];
---

<section class="relative overflow-hidden bg-[#0a0f14] py-16 text-white md:py-22">
  <!-- Iluminación ambiental suave en azul y cian (sin grillas técnicas) -->
  <div class="pointer-events-none absolute -top-32 left-1/4 h-[420px] w-[420px] rounded-full bg-brand-blue/15 blur-[130px]"></div>
  <div class="pointer-events-none absolute -bottom-32 right-10 h-[420px] w-[420px] rounded-full bg-brand-cyan/12 blur-[130px]"></div>

  <div class="relative z-10 mx-auto max-w-7xl px-5 md:px-8">
    <div class="max-w-2xl">
      <p class="text-[11px] font-extrabold uppercase tracking-[0.22em] text-brand-cyan">
        Del desorden manual a la claridad operacional
      </p>
      <h2 class="mt-2.5 text-3xl font-black leading-[1.08] tracking-tight text-white md:text-4xl">
        Menos caos. Más control.
      </h2>
      <p class="mt-3 text-base leading-relaxed text-slate-300">
        Deja atrás los procesos manuales, las planillas aisladas y la información dispersa. Con BaseLogic, tu operación funciona conectada en un solo lugar.
      </p>
    </div>

    <div class="relative mt-10 grid items-stretch gap-6 lg:grid-cols-2 lg:gap-8">
      <!-- Conector circular central en Desktop -->
      <div class="pointer-events-none hidden lg:flex absolute left-1/2 top-1/2 z-20 -translate-x-1/2 -translate-y-1/2 h-12 w-12 items-center justify-center rounded-full border-2 border-brand-cyan/60 bg-[#0a0f14] text-brand-cyan shadow-[0_0_30px_rgba(0,229,255,0.3)]">
        <ChevronRight class="h-5 w-5" />
      </div>

      <!-- Tarjeta Izquierda: ANTES -->
      <div class="flex flex-col rounded-3xl border border-white/10 bg-[#121922]/90 p-6 shadow-xl sm:p-7">
        <div class="flex flex-wrap items-center gap-3">
          <span class="inline-flex items-center gap-1.5 rounded-full bg-rose-500/20 px-3 py-1 text-xs font-extrabold text-rose-400 ring-1 ring-rose-500/30">
            <span class="h-1.5 w-1.5 rounded-full bg-rose-400"></span>
            Antes
          </span>
          <h3 class="text-lg font-extrabold text-white">
            Procesos manuales y dispersos
          </h3>
        </div>

        <div class="mt-5 overflow-hidden rounded-2xl border border-white/10 bg-slate-900">
          <img
            src="/images/generated/home/before-manual-chaos.jpg"
            alt="Operación saturada por carpetas físicas, notas adhesivas y múltiples planillas desconectadas"
            loading="lazy"
            decoding="async"
            class="aspect-[16/9] w-full object-cover object-center opacity-90"
          />
        </div>

        <ul class="mt-6 space-y-3">
          {
            beforeItems.map((item) => (
              <li class="flex items-center gap-3 text-sm font-medium text-slate-300">
                <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-rose-500/20 text-rose-400">
                  <X class="h-3 w-3 stroke-[2.5]" />
                </span>
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Tarjeta Derecha: AHORA -->
      <div class="flex flex-col rounded-3xl border border-brand-blue/40 bg-gradient-to-b from-[#10203b]/90 to-[#0d1728]/95 p-6 shadow-[0_24px_60px_-15px_rgba(0,102,255,0.28)] sm:p-7">
        <div class="flex flex-wrap items-center gap-3">
          <span class="inline-flex items-center gap-1.5 rounded-full bg-brand-blue px-3 py-1 text-xs font-extrabold text-white shadow-sm shadow-brand-blue/40">
            <Sparkles class="h-3 w-3 text-brand-cyan" />
            Ahora
          </span>
          <h3 class="text-lg font-extrabold text-white">
            Tu operación en un solo lugar
          </h3>
        </div>

        <div class="mt-5 overflow-hidden rounded-2xl border border-brand-cyan/25 bg-slate-900">
          <img
            src="/images/generated/home/after-operational-clarity.jpg"
            alt="Ejecutiva revisando una plataforma centralizada BaseLogic con indicadores claros y procesos en orden"
            loading="lazy"
            decoding="async"
            class="aspect-[16/9] w-full object-cover object-center"
          />
        </div>

        <ul class="mt-6 space-y-3">
          {
            afterItems.map((item) => (
              <li class="flex items-center gap-3 text-sm font-semibold text-white">
                <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-brand-cyan/20 text-brand-cyan ring-1 ring-brand-cyan/40">
                  <Check class="h-3 w-3 stroke-[2.5]" />
                </span>
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
