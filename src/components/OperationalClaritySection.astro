---
import { Check, ChevronRight, Sparkles, X } from 'lucide-react';

const beforeItems = [
  'Información dispersa en múltiples planillas',
  'Tareas manuales y repetitivas',
  'Poca trazabilidad sobre cobros, stock y equipos',
  'Errores y reprocesos frecuentes',
  'Decisiones tomadas con datos incompletos',
];

const afterItems = [
  'Procesos automatizados y flujos claros',
  'Información centralizada en una sola plataforma',
  'Trazabilidad de punta a punta',
  'Menos errores y mayor control del equipo',
  'Decisiones respaldadas por datos reales',
];
---

<section
  aria-labelledby="operational-clarity-heading"
  class="bl-home-section bl-home-section--tinted"
>
  <div class="operational-clarity-background pointer-events-none absolute inset-0" aria-hidden="true"></div>

  <div class="bl-home-section__container">
    <header class="bl-home-section__header" data-motion-reveal>
      <div>
        <p class="bl-home-section__eyebrow">Del desorden manual a la claridad operacional</p>
        <h2 id="operational-clarity-heading" class="bl-home-section__title">
          Menos caos. Más control.
        </h2>
      </div>
      <p class="bl-home-section__lede">
        BaseLogic centraliza tus procesos, reduce el trabajo manual y te da visibilidad y trazabilidad de toda la operación en un solo lugar.
      </p>
    </header>

    <div class="relative mt-7 grid items-stretch gap-4 sm:gap-5 lg:grid-cols-2 lg:gap-6">
      <article
        aria-labelledby="operational-before-heading"
        data-motion-reveal
        style="--home-motion-delay: 0ms"
        class="bl-home-card flex min-w-0 flex-col bg-white/65 p-5 sm:p-6 lg:p-4"
      >
        <div class="flex flex-wrap items-center gap-3">
          <span class="inline-flex shrink-0 items-center gap-2 rounded-full bg-[#ffe0e9] px-4 py-2 text-sm font-extrabold text-[#b30f39]">
            <span class="h-2 w-2 rounded-full bg-[#d21e49]"></span>
            Antes
          </span>
          <h3 id="operational-before-heading" class="text-xl font-extrabold leading-tight tracking-tight text-[#101b3d] sm:text-2xl lg:text-xl">
            Procesos manuales y dispersos
          </h3>
        </div>

        <div class="relative mt-5 aspect-[16/10] overflow-hidden rounded-[20px] bg-[#dfeaff]/90 sm:aspect-video lg:mt-4 lg:aspect-[2.4/1]">
          <img
            src="/images/operational-clarity/ilustracion-antes.webp"
            alt="Planillas desconectadas, papeles y tareas manuales dispersas en una operación"
            width="1080"
            height="727"
            loading="lazy"
            decoding="async"
            class="absolute inset-0 h-full w-full object-contain"
          />
        </div>

        <ul class="mt-5 space-y-2.5 sm:mt-6 sm:space-y-3 lg:mt-3 lg:space-y-1.5">
          {beforeItems.map((item) => (
            <li class="flex items-start gap-3 text-sm font-medium leading-6 text-[#172440] sm:text-base lg:gap-2.5 lg:text-sm lg:leading-5">
              <span class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-[#ffe0e9] text-[#d21e49] lg:h-6 lg:w-6">
                <X class="h-4 w-4 stroke-[2.5] lg:h-3.5 lg:w-3.5" aria-hidden="true" />
              </span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </article>

      <div
        aria-hidden="true"
        data-motion-reveal
        style="--home-motion-delay: 110ms"
        class="pointer-events-none z-20 mx-auto -my-2 flex h-12 w-12 items-center justify-center rounded-full border border-white bg-white text-[#0765ef] shadow-[0_12px_30px_-12px_rgba(0,89,220,0.42)] lg:absolute lg:left-1/2 lg:top-1/2 lg:m-0 lg:h-14 lg:w-14 lg:-translate-x-1/2 lg:-translate-y-1/2"
      >
        <ChevronRight class="h-6 w-6 rotate-90 lg:rotate-0" />
      </div>

      <article
        aria-labelledby="operational-after-heading"
        data-motion-reveal
        style="--home-motion-delay: 55ms"
        class="bl-home-card bl-home-card--accent flex min-w-0 flex-col bg-white/70 p-5 sm:p-6 lg:p-4"
      >
        <div class="flex flex-wrap items-center gap-3">
          <span class="inline-flex shrink-0 items-center gap-2 rounded-full bg-[#0961eb] px-4 py-2 text-sm font-extrabold text-white shadow-sm shadow-blue-700/20">
            <Sparkles class="h-4 w-4" aria-hidden="true" />
            Ahora
          </span>
          <h3 id="operational-after-heading" class="text-xl font-extrabold leading-tight tracking-tight text-[#101b3d] sm:text-2xl lg:text-xl">
            Tu operación en un solo lugar
          </h3>
        </div>

        <div class="relative mt-5 aspect-[16/10] overflow-hidden rounded-[20px] bg-[#e5efff]/85 sm:aspect-video lg:mt-4 lg:aspect-[2.4/1]">
          <img
            src="/images/operational-clarity/ilustracion-ahora.webp"
            alt="Panel web y aplicación móvil de BaseLogic con indicadores y procesos conectados"
            width="1215"
            height="757"
            loading="lazy"
            decoding="async"
            class="absolute inset-0 h-full w-full object-contain"
          />
        </div>

        <ul class="mt-5 space-y-2.5 sm:mt-6 sm:space-y-3 lg:mt-3 lg:space-y-1.5">
          {afterItems.map((item) => (
            <li class="flex items-start gap-3 text-sm font-medium leading-6 text-[#172440] sm:text-base lg:gap-2.5 lg:text-sm lg:leading-5">
              <span class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-[#d9f7fb] text-[#008ba8] lg:h-6 lg:w-6">
                <Check class="h-4 w-4 stroke-[2.5] lg:h-3.5 lg:w-3.5" aria-hidden="true" />
              </span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </article>
    </div>
  </div>
</section>

<style>
  .operational-clarity-background {
    background-image: url('/images/operational-clarity/fondo-claridad-operacional.webp');
    background-position: center;
    background-repeat: no-repeat;
    background-size: cover;
  }

  @media (max-width: 639px) {
    .operational-clarity-background {
      background-position: 62% top;
    }
  }
</style>
