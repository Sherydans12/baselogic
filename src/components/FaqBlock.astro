---
import { ChevronDown } from 'lucide-react';

interface Faq {
  question: string;
  answer: string;
}

interface Props {
  faqs: Faq[];
  title?: string;
}

const { faqs, title = 'Preguntas frecuentes' } = Astro.props;
---

<section class="border-t border-slate-200/70 bg-[#f8fbff] py-16 md:py-20">
  <div class="mx-auto max-w-4xl px-5 md:px-8">
    <div class="mb-10 text-center">
      <p class="text-[11px] font-bold uppercase tracking-[0.2em] text-brand-blue">Resolución de dudas</p>
      <h2 class="mt-2 text-3xl font-extrabold tracking-tight text-slate-950">{title}</h2>
    </div>
    <div class="grid gap-3.5">
      {faqs.map((faq) => (
        <details class="group rounded-2xl border border-slate-200/90 bg-white p-5 shadow-[0_8px_24px_-18px_rgba(10,15,20,0.06)] transition hover:border-brand-blue/30">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-bold text-slate-950">
            <span>{faq.question}</span>
            <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-slate-100 text-slate-600 transition-transform duration-200 group-open:rotate-180 group-open:bg-brand-blue/10 group-open:text-brand-blue">
              <ChevronDown class="h-4 w-4" />
            </span>
          </summary>
          <p class="mt-3.5 border-t border-slate-100 pt-3.5 text-sm leading-relaxed text-slate-600">{faq.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>
