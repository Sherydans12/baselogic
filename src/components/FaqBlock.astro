---
interface Faq {
  question: string;
  answer: string;
}

interface Props {
  faqs: Faq[];
  title?: string;
}

const { faqs, title = 'Preguntas frecuentes' } = Astro.props;
---

<section class="bg-white py-16">
  <div class="mx-auto max-w-4xl px-5 md:px-8">
    <h2 class="mb-8 text-3xl font-black text-slate-950">{title}</h2>
    <div class="grid gap-4">
      {faqs.map((faq) => (
        <details class="rounded-2xl border border-slate-200 bg-slate-50 p-5">
          <summary class="cursor-pointer list-none font-bold text-slate-950">{faq.question}</summary>
          <p class="mt-4 leading-7 text-slate-600">{faq.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>
