---
import { ChevronDown } from 'lucide-react';

interface Faq {
  question: string;
  answer: string;
}

interface Props {
  faqs: Faq[];
}

const { faqs } = Astro.props;
---

<div class="faq-list">
  {faqs.map((faq) => (
    <details>
      <summary>
        {faq.question}
        <span><ChevronDown width={18} height={18} aria-hidden="true" /></span>
      </summary>
      <p>{faq.answer}</p>
    </details>
  ))}
</div>

<style>
  .faq-list {
    border-top: 1px solid var(--interior-border);
  }

  details {
    border-bottom: 1px solid var(--interior-border);
  }

  summary {
    display: flex;
    min-height: 3.875rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.875rem 0.5rem;
    cursor: pointer;
    font-weight: 700;
    line-height: 1.45;
    list-style: none;
  }

  summary:focus-visible {
    outline-offset: -2px;
  }

  summary:hover,
  details[open] summary {
    color: var(--interior-link);
  }

  summary span {
    display: grid;
    width: 2rem;
    height: 2rem;
    flex: none;
    place-items: center;
    border-radius: 50%;
    background: #e6f0ff;
    color: var(--interior-link);
  }

  details[open] summary span {
    transform: rotate(180deg);
    background: var(--interior-link);
    color: white;
  }

  details p {
    max-width: 68ch;
    padding: 0 2.5rem 1.25rem 0.5rem;
    color: var(--interior-copy);
    line-height: 1.7;
  }

  @media (prefers-reduced-motion: no-preference) {
    summary span {
      transition: transform 180ms ease-out, background-color 160ms ease-out;
    }
  }
</style>
