---
import { ArrowUpRight, Mail, MapPin } from 'lucide-react';
import { contact } from '../data/contact';
import { site } from '../data/site';
---

<aside aria-labelledby="direct-contact-title" class="direct-contact">
  <h2 id="direct-contact-title">Contacto directo</h2>
  <a href={`mailto:${contact.email}`} class="interior-link">
    <Mail width={19} height={19} aria-hidden="true" />
    {contact.email}
    <ArrowUpRight width={15} height={15} aria-hidden="true" />
  </a>
  <p class="direct-contact__location">
    <MapPin width={19} height={19} aria-hidden="true" />
    <span>{site.serviceArea}</span>
  </p>
  <p class="direct-contact__note">{contact.responseNote}</p>
</aside>

<style>
  .direct-contact {
    border-top: 1px solid #cadcf4;
    padding: 1rem 0.25rem;
  }

  .direct-contact h2 {
    font-size: 1.125rem;
    font-weight: 800;
    letter-spacing: -0.025em;
  }

  .direct-contact__location {
    display: flex;
    align-items: start;
    gap: 0.625rem;
    color: var(--interior-copy);
    line-height: 1.5;
  }

  .direct-contact__location svg {
    flex: none;
    margin-top: 0.125rem;
    color: var(--interior-link);
  }

  .direct-contact__note {
    margin-top: 0.875rem;
    color: var(--interior-copy);
    font-size: 0.9375rem;
    line-height: 1.6;
  }
</style>
