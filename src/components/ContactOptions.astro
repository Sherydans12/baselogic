---
import { Mail, MapPin } from 'lucide-react';
import { contact } from '../data/contact';
import { site } from '../data/site';
---

<aside class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
  <h2 class="text-2xl font-black text-slate-950">Hablemos de tu proyecto</h2>
  <p class="mt-3 leading-7 text-slate-600">{contact.responseNote}</p>
  <div class="mt-6 grid gap-4">
    <a href={`mailto:${contact.email}`} class="flex items-center gap-3 rounded-2xl bg-brand-blue/10 p-4 font-bold text-slate-900">
      <Mail class="h-5 w-5 text-brand-blue" />
      {contact.email}
    </a>
    <div class="flex items-center gap-3 rounded-2xl bg-slate-50 p-4 font-bold text-slate-900">
      <MapPin class="h-5 w-5 text-brand-blue" />
      {site.serviceArea}
    </div>
  </div>
</aside>
