---
import { ArrowRight } from 'lucide-react';

interface RelatedItem {
  title: string;
  href: string;
  summary: string;
}

interface Props {
  items: RelatedItem[];
  title?: string;
}

const { items, title = 'Servicios o productos relacionados' } = Astro.props;
---

<section class="bg-slate-50 py-18 md:py-20">
  <div class="mx-auto max-w-7xl px-5 md:px-8">
    <h2 class="mb-8 text-3xl font-black text-slate-950 md:text-4xl">{title}</h2>
    <div class="grid gap-5 md:grid-cols-3">
      {items.map((item) => (
        <article class="flex min-h-[220px] flex-col rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
          <h3 class="text-xl font-black text-slate-950">{item.title}</h3>
          <p class="mt-3 flex-1 leading-7 text-slate-600">{item.summary}</p>
          <a href={item.href} class="mt-6 inline-flex items-center gap-2 text-sm font-bold text-brand-blue hover:text-slate-950">
            Ver mas
            <ArrowRight class="h-4 w-4" />
          </a>
        </article>
      ))}
    </div>
  </div>
</section>
