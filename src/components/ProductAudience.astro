---
import { ArrowRight, CheckCircle2, Target } from 'lucide-react';
interface Props { title: string; description: string; audience: string[]; useCases: string[] }
const { title, description, audience, useCases } = Astro.props;
---
<section class="bg-white py-14 md:py-16">
  <div class="mx-auto grid max-w-7xl gap-8 px-5 md:px-8 lg:grid-cols-2 lg:gap-12">
    <div>
      <h2 class="text-3xl font-black tracking-[-0.03em] text-[#0b1a4c]">{title}</h2>
      <p class="mt-4 max-w-xl text-base leading-relaxed text-[#405578]">{description}</p>
      <ul class="mt-6 grid gap-3">
        {audience.map((item) => <li class="flex items-start gap-3 text-[0.95rem] leading-relaxed text-[#243b61]"><CheckCircle2 class="mt-0.5 h-5 w-5 shrink-0 text-[#0964ef]" aria-hidden="true" /><span>{item}</span></li>)}
      </ul>
    </div>
    <div class="rounded-3xl bg-[#f1f6ff] p-6 sm:p-8">
      <div class="flex items-center gap-3"><span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-white text-[#0964ef]"><Target class="h-5 w-5" aria-hidden="true" /></span><h2 class="text-2xl font-extrabold tracking-[-0.025em] text-[#0b1a4c]">En la práctica</h2></div>
      <ul class="mt-5 grid gap-3 border-t border-[#d9e5f5] pt-5">
        {useCases.map((item) => <li class="flex items-start gap-3 text-[0.95rem] leading-relaxed text-[#405578]"><ArrowRight class="mt-1 h-4 w-4 shrink-0 text-[#0964ef]" aria-hidden="true" /><span>{item}</span></li>)}
      </ul>
    </div>
  </div>
</section>
