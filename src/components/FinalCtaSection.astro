---
import { ArrowRight } from 'lucide-react';
import { home } from '../data/home';
---

<section class="bg-brand-blue py-16 text-white">
  <div class="mx-auto flex max-w-7xl flex-col gap-8 px-5 md:px-8 lg:flex-row lg:items-center lg:justify-between">
    <div class="max-w-3xl">
      <h2 class="text-3xl font-black tracking-tight md:text-4xl">{home.finalCta.title}</h2>
      <p class="mt-4 text-lg leading-8 text-blue-50">{home.finalCta.text}</p>
    </div>
    <a
      href={home.finalCta.href}
      class="inline-flex shrink-0 items-center justify-center gap-2 rounded-full bg-white px-6 py-3.5 text-base font-bold text-brand-blue transition hover:bg-slate-950 hover:text-white"
    >
      {home.finalCta.label}
      <ArrowRight class="h-5 w-5" />
    </a>
  </div>
</section>
