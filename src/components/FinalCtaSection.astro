---
/**
 * FinalCtaSection.astro
 * Cierre comercial luminoso de la Home («Claridad operacional para un mayor crecimiento — Hablemos de tu próximo paso»).
 */
import { ArrowRight, BarChart3 } from 'lucide-react';
import { contact, createContactMailtoHref } from '../data/contact';

const directMailHref = createContactMailtoHref(contact.whatsappMessages.general);
---

<section class="home-final-cta relative overflow-hidden bg-gradient-to-r from-[#eef6fc] via-[#f5faff] to-[#e4f0fb] py-16 md:py-22 border-t border-slate-200/80">
  <div class="pointer-events-none absolute -right-24 -bottom-24 h-[420px] w-[420px] rounded-full bg-brand-blue/12 blur-[120px]"></div>

  <div class="relative z-10 mx-auto max-w-7xl px-5 md:px-8">
    <div class="grid items-center gap-8 lg:grid-cols-[1.15fr_0.85fr]">
      <div>
        <p class="text-[11px] font-extrabold uppercase tracking-[0.22em] text-slate-500">
          Claridad operacional para un mayor crecimiento
        </p>
        <h2 class="mt-2.5 text-3xl font-black leading-[1.08] tracking-tight text-slate-950 md:text-5xl">
          Hablemos de tu próximo paso
        </h2>
        <p class="mt-4 max-w-xl text-base leading-relaxed text-slate-600">
          Cuéntanos tu desafío operativo o comercial y evaluemos juntos cómo ordenar, conectar y hacer crecer tu operación con tecnología a tu medida.
        </p>

        <div class="mt-7 flex flex-wrap items-center gap-5">
          <a
            href="/contacto#formulario"
            class="group inline-flex items-center justify-center gap-2.5 rounded-xl bg-brand-blue px-7 py-4 text-sm font-bold text-white shadow-lg shadow-brand-blue/25 transition-all duration-200 hover:bg-slate-950 hover:-translate-y-0.5 sm:text-base"
          >
            <span>Hablemos ahora</span>
            <ArrowRight class="h-4 w-4 transition-transform group-hover:translate-x-1" />
          </a>

          <a
            href={directMailHref}
            class="inline-flex items-center gap-1.5 py-2 text-sm font-bold text-brand-blue underline decoration-brand-blue/40 underline-offset-8 transition hover:text-slate-950"
          >
            Escribir a {contact.email}
          </a>
        </div>
      </div>

      <!-- Tarjeta ejecutiva flotante derecha -->
      <div class="flex lg:justify-end">
        <div class="inline-flex items-center gap-4 rounded-2xl border border-white/90 bg-white/90 p-5 shadow-[0_20px_50px_-15px_rgba(15,23,42,0.12)] backdrop-blur-md sm:p-6">
          <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-blue-50 text-brand-blue ring-1 ring-blue-100">
            <BarChart3 class="h-6 w-6" />
          </div>
          <div>
            <p class="text-base font-black leading-snug text-slate-950">
              Más control.<br />
              Más eficiencia.<br />
              Más crecimiento.
            </p>
            <p class="mt-1 text-xs font-medium text-slate-500">
              Región de Coquimbo · Atención a todo Chile
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
