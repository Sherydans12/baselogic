---
import { ArrowRight, Mail, Sparkles } from 'lucide-react';
import { home } from '../data/home';
import { contact, createContactMailtoHref } from '../data/contact';

const contactHref = createContactMailtoHref(contact.whatsappMessages.general);
---

<section class="relative overflow-hidden bg-gradient-to-r from-brand-blue via-blue-600 to-slate-900 py-20 text-white">
  <!-- Glowing background accents -->
  <div class="pointer-events-none absolute -top-24 -right-24 h-96 w-96 rounded-full bg-cyan-400/20 blur-3xl"></div>
  <div class="pointer-events-none absolute -bottom-24 -left-24 h-96 w-96 rounded-full bg-blue-400/20 blur-3xl"></div>

  <div class="mx-auto flex max-w-7xl flex-col gap-10 px-5 md:px-8 lg:flex-row lg:items-center lg:justify-between relative z-10">
    <div class="max-w-3xl">
      <span class="inline-flex items-center gap-1.5 rounded-full bg-white/10 backdrop-blur-md px-3.5 py-1.5 text-xs font-bold uppercase tracking-wider text-cyan-200 shadow-sm border border-white/15">
        <Sparkles class="h-3.5 w-3.5 text-cyan-300" />
        Claridad operacional para tu negocio
      </span>
      <h2 class="mt-4 text-3xl font-black tracking-tight text-white md:text-5xl leading-tight">
        {home.finalCta.title}
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-blue-100">
        {home.finalCta.text} Revisamos tu requerimiento, definimos el alcance y te proponemos una ruta de implementación por etapas.
      </p>
    </div>

    <div class="flex flex-col gap-3.5 sm:flex-row shrink-0">
      <a
        href={home.finalCta.href}
        class="inline-flex items-center justify-center gap-2 rounded-full bg-white px-7 py-4 text-base font-bold text-slate-950 shadow-xl transition-all duration-200 hover:bg-brand-cyan hover:shadow-cyan-400/30 hover:-translate-y-0.5"
      >
        {home.finalCta.label}
        <ArrowRight class="h-5 w-5" />
      </a>
      <a
        href={contactHref}
        class="inline-flex items-center justify-center gap-2 rounded-full border border-white/20 bg-white/10 backdrop-blur-md px-6 py-4 text-base font-bold text-white shadow-sm transition-all duration-200 hover:bg-white/20 hover:border-white/40"
      >
        <Mail class="h-5 w-5 text-cyan-200" />
        Escribir por correo
      </a>
    </div>
  </div>
</section>
