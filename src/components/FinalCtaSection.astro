---
import { ArrowRight, Mail, CheckCircle2 } from 'lucide-react';
import { home } from '../data/home';
import { contact, createContactMailtoHref } from '../data/contact';

const contactHref = createContactMailtoHref(contact.whatsappMessages.general);
---

<section
  id="evaluacion-proyecto"
  aria-labelledby="final-cta-heading"
  class="relative overflow-hidden bg-[#090d16] bg-tech-grid-dark py-16 text-white md:py-20"
>
  <div class="mx-auto max-w-7xl px-5 md:px-8">
    <div class="rounded-2xl border border-slate-800 bg-slate-900/90 p-7 md:p-10">
      <div class="grid gap-8 lg:grid-cols-[1.2fr_0.8fr] lg:items-center">
        <div>
          <span class="inline-flex items-center gap-2 rounded border border-slate-700 bg-slate-950 px-3 py-1 font-mono text-xs font-semibold text-cyan-300">
            07 / EVALUACIÓN Y SIGUIENTE PASO
          </span>
          <h2
            id="final-cta-heading"
            class="mt-3 text-2xl font-black tracking-tight text-white md:text-4xl leading-tight"
          >
            {home.finalCta.title}
          </h2>
          <p class="mt-3 text-sm leading-6 text-slate-300 md:text-base md:leading-7">
            {home.finalCta.text} Revisamos tu requerimiento, definimos el alcance técnico y te proponemos una ruta de implementación por etapas.
          </p>

          <ul class="mt-5 flex flex-wrap gap-x-6 gap-y-2 text-xs font-medium text-slate-300">
            <li class="flex items-center gap-1.5">
              <CheckCircle2 class="h-4 w-4 text-cyan-400" />
              Alcance documentado antes de iniciar
            </li>
            <li class="flex items-center gap-1.5">
              <CheckCircle2 class="h-4 w-4 text-cyan-400" />
              Sin promesas irreales ni costos ocultos
            </li>
            <li class="flex items-center gap-1.5">
              <CheckCircle2 class="h-4 w-4 text-cyan-400" />
              Atención desde Región de Coquimbo a todo Chile
            </li>
          </ul>
        </div>

        <div class="flex flex-col gap-3 sm:flex-row lg:flex-col">
          <a
            href="/contacto#formulario"
            class="inline-flex items-center justify-center gap-2 rounded-full bg-brand-blue px-6 py-4 text-base font-bold text-white shadow-sm transition hover:bg-cyan-400 hover:text-slate-950"
          >
            {home.finalCta.label}
            <ArrowRight class="h-5 w-5" />
          </a>
          <a
            href={contactHref}
            class="inline-flex items-center justify-center gap-2 rounded-full border border-slate-700 bg-slate-950 px-6 py-3.5 text-sm font-bold text-slate-200 transition hover:border-cyan-400 hover:text-white"
          >
            <Mail class="h-4 w-4 text-cyan-300" />
            Escribir a {contact.email}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
