---
import SectionHeading from './SectionHeading.astro';

interface Step {
  title: string;
  text: string;
}

interface Props {
  title?: string;
  text?: string;
  steps: Step[];
}

const {
  title = 'Proceso claro de trabajo',
  text = 'Avanzamos por etapas para que el proyecto sea comprensible, manejable y útil desde la primera versión.',
  steps,
} = Astro.props;
---

<section class="bg-white py-18 md:py-20">
  <div class="mx-auto max-w-7xl px-5 md:px-8">
    <SectionHeading title={title} text={text} />
    <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-4">
      {steps.map((step, index) => (
        <article class="rounded-2xl border border-slate-200 bg-slate-50 p-6">
          <p class="mb-5 flex h-10 w-10 items-center justify-center rounded-full bg-brand-blue text-sm font-black text-white">
            {index + 1}
          </p>
          <h2 class="text-xl font-black text-slate-950">{step.title}</h2>
          <p class="mt-3 leading-7 text-slate-600">{step.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>
