---
interface Props {
  eyebrow?: string;
  title: string;
  text: string;
}

const { eyebrow, title, text } = Astro.props;
---

<section class="commercial-surface border-b border-slate-200 py-16 md:py-20">
  <div class="mx-auto max-w-7xl px-5 md:px-8">
    {eyebrow && <p class="mb-4 text-sm font-bold uppercase tracking-wide text-brand-blue">{eyebrow}</p>}
    <h1 class="max-w-4xl text-4xl font-black tracking-tight text-slate-950 md:text-6xl">{title}</h1>
    <p class="mt-6 max-w-3xl text-lg leading-8 text-slate-600 md:text-xl">{text}</p>
  </div>
</section>
