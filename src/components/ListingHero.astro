---
import { ArrowRight } from 'lucide-react';
import type { VisualAsset } from '../data/visualAssets';
import HeroVisual from './HeroVisual.astro';

interface Props {
  eyebrow?: string;
  title: string;
  text: string;
  asset?: VisualAsset;
  ctaLabel?: string;
  ctaHref?: string;
}

const { eyebrow, title, text, asset, ctaLabel, ctaHref } = Astro.props;
const hasVisual = asset?.status === 'approved' && Boolean(asset.src);
const hasCta = Boolean(ctaLabel && ctaHref);
---

<section class="commercial-surface border-b border-slate-200 py-16 md:py-20">
  <div class={`mx-auto max-w-7xl px-5 md:px-8 ${hasVisual ? 'grid items-center gap-12 lg:grid-cols-[1fr_1fr]' : ''}`}>
    <div>
      {eyebrow && <p class="mb-4 text-sm font-bold uppercase tracking-wide text-brand-blue">{eyebrow}</p>}
      <h1 class="max-w-4xl text-4xl font-black tracking-tight text-slate-950 md:text-6xl">{title}</h1>
      <p class="mt-6 max-w-3xl text-lg leading-8 text-slate-600 md:text-xl">{text}</p>
      {hasCta && (
        <a
          href={ctaHref}
          class="mt-8 inline-flex items-center justify-center gap-2 rounded-full bg-brand-blue px-6 py-3.5 text-base font-bold text-white transition hover:bg-slate-950"
        >
          {ctaLabel}
          <ArrowRight class="h-5 w-5" />
        </a>
      )}
    </div>
    {hasVisual && (
      <HeroVisual asset={asset} priority={true} />
    )}
  </div>
</section>
