---
import { ArrowRight, Globe2, Cpu, Layers } from 'lucide-react';

const commercialRoutes = [
  {
    code: 'RUTA 01 · PRESENCIA Y CAPTACIÓN',
    icon: Globe2,
    profile: 'Pymes, comercios y empresas de servicios',
    title: 'Necesito presencia digital y captar consultas reales',
    description:
      'Para negocios que requieren proyectar confianza comercial fuera de redes sociales, explicar su oferta con claridad y recibir contactos calificados.',
    solutions: [
      { label: 'Páginas web corporativas y comerciales', href: '/servicios/paginas-web' },
      { label: 'Landing pages para campañas y servicios', href: '/servicios/landing-pages' },
      { label: 'Sitios WordPress autogestionables', href: '/servicios/wordpress' },
      { label: 'Planes referenciales desde $149.000', href: '/planes' },
    ],
    ctaLabel: 'Cotizar sitio web',
    ctaHref: '/contacto?servicio=paginas-web#formulario',
  },
  {
    code: 'RUTA 02 · SISTEMAS Y AUTOMATIZACIÓN',
    icon: Cpu,
    profile: 'Operaciones que superaron las planillas dispersas',
    title: 'Necesito ordenar procesos internos o un sistema a medida',
    description:
      'Cuando la operación depende de hojas de cálculo desconectadas y mensajes sueltos, diseñamos paneles internos, flujos y automatizaciones por etapas.',
    solutions: [
      { label: 'Sistemas y paneles administrativos a medida', href: '/servicios/sistemas-para-pymes' },
      { label: 'Automatización de avisos, estados y reportes', href: '/servicios/automatizacion' },
      { label: 'Formularios internos, roles y trazabilidad', href: '/servicios/sistemas-para-pymes' },
      { label: 'Escenarios operativos por rubro', href: '/casos-de-exito' },
    ],
    ctaLabel: 'Evaluar mi proceso',
    ctaHref: '/contacto?servicio=sistemas-para-pymes#formulario',
  },
  {
    code: 'RUTA 03 · PLATAFORMAS BASELOGIC',
    icon: Layers,
    profile: 'Minería, educación, servicios por hora y comercio',
    title: 'Busco implementar una plataforma especializada BaseLogic',
    description:
      'Software vertical desarrollado por BaseLogic para resolver ciclos operacionales complejos con arquitectura probada y adaptación a tu organización.',
    solutions: [
      { label: 'BaseLogic EAM · Activos, OT, compras y bodega', href: '/productos/eam' },
      { label: 'BaseLogic EduPay · Gestión financiera escolar', href: '/productos/edupay' },
      { label: 'BaseLogic Booking · Agenda y recursos por hora', href: '/productos/booking' },
      { label: 'BaseLogic POS · Punto de venta (Piloto)', href: '/productos/pos' },
    ],
    ctaLabel: 'Explorar plataformas',
    ctaHref: '/productos',
  },
];
---

<section
  id="rutas-comerciales"
  aria-labelledby="rutas-heading"
  class="border-b border-slate-200 bg-white py-16 md:py-20"
>
  <div class="mx-auto max-w-7xl px-5 md:px-8">
    <div class="flex flex-col justify-between gap-4 border-b border-slate-200 pb-8 lg:flex-row lg:items-end">
      <div class="max-w-2xl">
        <span class="font-mono text-xs font-bold uppercase tracking-wider text-brand-blue">
          01 / SEGMENTACIÓN Y RUTAS DE ENTRADA
        </span>
        <h2 id="rutas-heading" class="mt-2 text-2xl font-black tracking-tight text-slate-950 md:text-4xl">
          Identifica la ruta técnica adecuada para la etapa de tu empresa
        </h2>
      </div>
      <p class="max-w-md text-sm leading-6 text-slate-600">
        No ofrecemos la misma plantilla para todo. Estructuramos nuestras capacidades según el nivel de madurez operativa que necesitas resolver hoy.
      </p>
    </div>

    <div class="mt-10 grid gap-6 lg:grid-cols-3">
      {commercialRoutes.map((route) => {
        const Icon = route.icon;
        return (
          <article class="flex flex-col justify-between rounded-2xl border border-slate-200 bg-slate-50/70 p-6 transition hover:border-brand-blue/40 hover:bg-white hover:shadow-md">
            <div>
              <div class="flex items-center justify-between gap-2">
                <span class="font-mono text-[11px] font-bold uppercase tracking-wider text-brand-blue">
                  {route.code}
                </span>
                <div class="flex h-9 w-9 items-center justify-center rounded-xl border border-slate-200 bg-white text-brand-blue">
                  <Icon class="h-4 w-4" />
                </div>
              </div>

              <p class="mt-3 font-mono text-xs font-medium text-slate-500">
                Perfil: {route.profile}
              </p>
              <h3 class="mt-1.5 text-xl font-black leading-snug text-slate-950">
                {route.title}
              </h3>
              <p class="mt-2.5 text-sm leading-6 text-slate-600">
                {route.description}
              </p>

              <div class="mt-5 border-t border-slate-200/80 pt-4">
                <span class="font-mono text-[11px] font-semibold uppercase tracking-wider text-slate-500">
                  Alcances y rutas directas
                </span>
                <ul class="mt-2.5 space-y-2 text-sm">
                  {route.solutions.map((item) => (
                    <li>
                      <a
                        href={item.href}
                        class="group flex items-center justify-between rounded-lg border border-slate-200/80 bg-white px-3 py-2 text-xs font-semibold text-slate-800 transition hover:border-brand-blue hover:text-brand-blue"
                      >
                        <span>{item.label}</span>
                        <ArrowRight class="h-3.5 w-3.5 shrink-0 text-slate-400 transition-transform group-hover:translate-x-0.5 group-hover:text-brand-blue" />
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            <div class="mt-6 pt-2">
              <a
                href={route.ctaHref}
                class="inline-flex w-full items-center justify-center gap-2 rounded-full bg-slate-950 px-5 py-3 text-sm font-bold text-white transition hover:bg-brand-blue"
              >
                {route.ctaLabel}
                <ArrowRight class="h-4 w-4" />
              </a>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>
