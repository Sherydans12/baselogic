---
import { Globe2, Settings2, Wrench, ShieldCheck, Zap, Sparkles } from 'lucide-react';
import SectionHeading from './SectionHeading.astro';
import { home } from '../data/home';
import { visualAssets } from '../data/visualAssets';

const icons = [Globe2, Settings2, Wrench];
const badges = ['Presencia & Ventas', 'Orden Operativo', 'Respaldo Directo'];
---

<section class="relative bg-slate-50/70 py-20 md:py-28 border-b border-slate-200/80 overflow-hidden">
  <!-- Soft background blur circles -->
  <div class="pointer-events-none absolute top-0 left-1/2 -translate-x-1/2 h-[300px] w-[800px] rounded-full bg-cyan-400/5 blur-[120px]"></div>

  <div class="mx-auto max-w-7xl px-5 md:px-8">
    <SectionHeading
      eyebrow="Que hacemos"
      title="Soluciones digitales que se entienden y se pueden usar"
      text="Combinamos diseño web moderno, sistemas a medida y soporte local para que tu negocio gane presencia, orden y continuidad."
      align="center"
    />

    <!-- Main Grid: Visual Feature Card + 3 Interactive Pillars -->
    <div class="mt-12 grid gap-8 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
      <!-- Left: Nature-Tech Visual Feature Card -->
      <div class="group relative overflow-hidden rounded-3xl border border-slate-200/80 bg-white p-3 shadow-xl shadow-slate-900/5 transition-all duration-300 hover:shadow-2xl hover:shadow-slate-900/10">
        <div class="relative aspect-[16/10] overflow-hidden rounded-2xl bg-slate-100">
          <img
            src={visualAssets.home.natureTech.src}
            alt={visualAssets.home.natureTech.alt}
            loading="lazy"
            decoding="async"
            class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-slate-950/20 to-transparent"></div>
          
          <div class="absolute bottom-5 left-5 right-5 text-white">
            <h4 class="text-xl font-bold leading-snug text-white md:text-2xl">
              Tecnología pensada para resolver, no para complicar
            </h4>
            <p class="mt-1 text-sm text-slate-200">
              Unimos la fluidez digital con el soporte humano cercano en Chile.
            </p>
          </div>
        </div>
      </div>

      <!-- Right: 3 Interactive Feature Cards -->
      <div class="grid gap-4">
        {home.whatWeDo.map((item, index) => {
          const Icon = icons[index];
          const badge = badges[index];
          return (
            <article class="group relative overflow-hidden rounded-2xl border border-slate-200/80 bg-white p-6 shadow-xs transition-all duration-200 hover:-translate-y-0.5 hover:border-brand-blue/30 hover:shadow-md">
              <div class="flex items-start gap-4">
                <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-blue-50 text-brand-blue transition-colors group-hover:bg-brand-blue group-hover:text-white">
                  <Icon class="h-6 w-6" />
                </div>
                <div>
                  <span class="text-xs font-bold uppercase tracking-wider text-brand-blue">
                    {badge}
                  </span>
                  <h3 class="text-lg font-bold text-slate-950 md:text-xl">
                    {item.title}
                  </h3>
                  <p class="mt-2 text-sm leading-relaxed text-slate-600">
                    {item.text}
                  </p>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </div>
</section>
