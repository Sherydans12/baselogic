---
/**
 * WhatWeDoSection.astro
 * Sección 2 de la Home: Tres rutas comerciales claras por tipo de cliente
 * (Pymes y comercio, Instituciones educativas, Operaciones, minería e industria).
 */
import { ArrowRight, Check, ChevronRight, GraduationCap, HardHat, Store } from 'lucide-react';

const clientRoutes = [
  {
    title: 'Pymes y comercio',
    description:
      'Digitaliza, automatiza y haz crecer tu negocio con soluciones simples, claras y escalables.',
    icon: Store,
    href: '/servicios',
    items: [
      'Sitios web profesionales',
      'Automatizaciones operativas',
      'Sistemas de reserva, caja y stock',
    ],
  },
  {
    title: 'Instituciones educativas',
    description:
      'Soluciones especializadas para colegios, sostenedores e instituciones de formación.',
    icon: GraduationCap,
    href: '/productos/edupay',
    items: [
      'Gestión financiera escolar y pagos',
      'Automatización de cobros y matrículas',
      'Integración con ecosistema académico',
    ],
  },
  {
    title: 'Operaciones, minería e industria',
    description:
      'Software robusto para entornos exigentes, con foco en control de activos, trazabilidad y eficiencia.',
    icon: HardHat,
    href: '/productos/eam',
    items: [
      'Gestión de activos y mantención (EAM)',
      'Sistemas y paneles a medida',
      'Control de bodega y operación en terreno',
    ],
  },
];
---

<section class="relative bg-white py-16 md:py-22">
  <div class="mx-auto max-w-7xl px-5 md:px-8">
    <!-- Encabezado editorial con enlace secundario alineado -->
    <div class="flex flex-col justify-between gap-4 md:flex-row md:items-end">
      <div class="max-w-2xl">
        <p class="text-[11px] font-extrabold uppercase tracking-[0.2em] text-slate-500">
          Tres rutas, un mismo objetivo
        </p>
        <h2 class="mt-2.5 text-3xl font-black leading-[1.1] tracking-tight text-slate-950 md:text-4xl">
          Soluciones para cada etapa de tu negocio
        </h2>
        <p class="mt-3 text-base leading-relaxed text-slate-600">
          Desde sitios web profesionales hasta sistemas empresariales a medida, te acompañamos con la tecnología que tu operación necesita.
        </p>
      </div>

      <a
        href="/soluciones"
        class="inline-flex items-center gap-1.5 text-sm font-bold text-brand-blue transition hover:text-slate-950"
      >
        <span>Conoce todas las soluciones</span>
        <ArrowRight class="h-4 w-4" />
      </a>
    </div>

    <!-- 3 tarjetas limpias, luminosas y ejecutivas -->
    <div class="mt-10 grid gap-6 lg:grid-cols-3">
      {
        clientRoutes.map((route) => {
          const Icon = route.icon;
          return (
            <a
              href={route.href}
              class="group relative flex flex-col justify-between rounded-3xl border border-slate-200/80 bg-gradient-to-b from-[#f8fbff] to-white p-7 shadow-[0_12px_35px_-15px_rgba(15,23,42,0.08)] transition-all duration-300 hover:-translate-y-1 hover:border-brand-blue/35 hover:shadow-[0_22px_45px_-16px_rgba(0,102,255,0.16)]"
            >
              <div>
                <div class="flex items-center gap-3.5">
                  <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-blue-50 text-brand-blue ring-1 ring-blue-100 transition-colors group-hover:bg-brand-blue group-hover:text-white">
                    <Icon class="h-6 w-6" />
                  </div>
                  <h3 class="text-lg font-black tracking-tight text-slate-950">
                    {route.title}
                  </h3>
                </div>

                <p class="mt-4 text-sm leading-relaxed text-slate-600">
                  {route.description}
                </p>

                <ul class="mt-5 space-y-2.5">
                  {route.items.map((item) => (
                    <li class="flex items-center gap-2.5 text-sm font-medium text-slate-700">
                      <Check class="h-4 w-4 shrink-0 text-brand-blue" />
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <div class="mt-6 flex justify-end">
                <span class="flex h-9 w-9 items-center justify-center rounded-full border border-slate-200 bg-white text-brand-blue shadow-2xs transition-all group-hover:border-brand-blue group-hover:bg-brand-blue group-hover:text-white">
                  <ChevronRight class="h-4 w-4" />
                </span>
              </div>
            </a>
          );
        })
      }
    </div>
  </div>
</section>
