---
import { ArrowRight, Check, Layers3, Monitor, Settings2 } from 'lucide-react';
import { plans, plansNotes } from '../data/plans';

const planIcons = [Monitor, Layers3, Settings2];
---

<section id="planes-referenciales" aria-labelledby="home-plans-heading" class="bl-home-section bl-home-section--white">
  <div class="bl-home-section__container">
    <header class="bl-home-section__header">
      <div>
        <p class="bl-home-section__eyebrow">Planes referenciales</p>
        <h2 id="home-plans-heading" class="bl-home-section__title">
          Puntos de partida claros <span class="text-brand-blue">para cotizar</span>
        </h2>
      </div>
      <p class="bl-home-section__lede">
        Los planes ayudan a orientar el alcance inicial. Si tu operación requiere un desarrollo a medida o un producto propio, lo evaluamos contigo.
      </p>
    </header>

    <div class="mt-7 grid items-stretch gap-4 md:mt-8 lg:grid-cols-3 lg:gap-5">
      {plans.map((plan, index) => {
        const PlanIcon = planIcons[index];
        const isFeatured = index === 1;
        return (
          <article class:list={[
              'flex min-w-0 flex-col rounded-3xl border p-6 sm:p-7 lg:p-5',
            isFeatured
              ? 'border-[#8dbaff] bg-[#f0f6ff] shadow-[0_18px_38px_-30px_rgba(0,78,190,0.42)]'
              : 'border-[#dce8f8] bg-[#f8fbff]',
          ]}>
            <div class="flex min-h-12 items-center justify-between gap-3">
              <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-white text-[#0964ef] ring-1 ring-[#d7e6fb]">
                <PlanIcon class="h-6 w-6" aria-hidden="true" />
              </span>
              {isFeatured && (
                <span class="rounded-full bg-[#dceaff] px-3 py-1.5 text-xs font-bold text-[#0750bd]">
                  Más solicitado
                </span>
              )}
            </div>

            <h3 class="mt-5 text-xl font-extrabold tracking-[-0.025em] text-[#0b1a4c]">{plan.name}</h3>
            <div class="mt-4 flex flex-wrap items-baseline gap-x-2 gap-y-1">
              <span class="text-sm font-semibold text-[#405578]">Desde</span>
              <span class="text-3xl font-black tracking-[-0.03em] text-[#0b1a4c] sm:text-4xl lg:text-3xl">{plan.price}</span>
            </div>
            <p class="mt-4 text-[0.96rem] leading-relaxed text-[#405578] lg:min-h-[4.75rem]">{plan.summary}</p>

            <div class="mt-6 border-t border-[#d9e5f5] pt-5">
              <p class="text-sm font-bold text-[#0b1a4c]">Incluye</p>
              <ul class="mt-3 grid gap-3 text-sm leading-5 text-[#31466d]">
                {plan.includes.map((item) => (
                  <li class="flex items-start gap-2.5">
                    <Check class="mt-0.5 h-4 w-4 shrink-0 text-[#0964ef]" strokeWidth={2.5} aria-hidden="true" />
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="mt-auto pt-6">
              <p class="border-t border-[#d9e5f5] pt-4 text-sm leading-relaxed text-[#405578]">
                <strong class="font-bold text-[#0b1a4c]">Ideal para:</strong> {plan.idealFor}
              </p>
              <a
                href={`/planes#plan-${plan.id}`}
                aria-label={`Ver detalle del plan ${plan.name}`}
                class:list={[
                  'group mt-5 flex min-h-12 items-center justify-between gap-3 rounded-xl border px-4 py-3 text-sm font-bold transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#075be8]',
                  isFeatured
                    ? 'border-[#0964ef] bg-[#0964ef] text-white hover:border-[#064bb7] hover:bg-[#064bb7]'
                    : 'border-[#c9daf1] bg-white text-[#0754c9] hover:border-[#0964ef] hover:bg-[#edf5ff]',
                ]}
              >
                Ver detalle del plan
                <ArrowRight class="h-4 w-4 shrink-0 transition-transform group-hover:translate-x-1" aria-hidden="true" />
              </a>
            </div>
          </article>
        );
      })}
    </div>

    <div class="mt-6 flex flex-col gap-4 border-t border-[#dce8f8] pt-5 md:flex-row md:items-center md:justify-between md:gap-8">
      <div class="max-w-4xl space-y-1 text-sm leading-relaxed text-[#405578]">
        {plansNotes.map((note) => <p>{note}</p>)}
      </div>
      <a href="/planes" class="group inline-flex shrink-0 items-center gap-2 self-start py-2 text-sm font-bold text-[#0754c9] transition-colors hover:text-[#0b1a4c] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#075be8] md:self-center">
        Ver todos los planes
        <ArrowRight class="h-4 w-4 transition-transform group-hover:translate-x-1" aria-hidden="true" />
      </a>
    </div>
  </div>
</section>
