---
import { ArrowRight, CheckCircle2, ChevronDown } from 'lucide-react';
import { plans, plansNotes } from '../data/plans';
import { generalFaqs } from '../data/faqs';
---

<section
  id="planes-y-faq"
  aria-labelledby="planes-faq-heading"
  class="border-b border-slate-200 bg-white py-16 md:py-20"
>
  <div class="mx-auto max-w-7xl px-5 md:px-8">
    <!-- Cabecera de sección -->
    <div class="flex flex-col justify-between gap-4 border-b border-slate-200 pb-8 lg:flex-row lg:items-end">
      <div class="max-w-3xl">
        <span class="font-mono text-xs font-bold uppercase tracking-wider text-brand-blue">
          06 / PLANES REFERENCIALES Y PREGUNTAS FRECUENTES
        </span>
        <h2 id="planes-faq-heading" class="mt-2 text-2xl font-black tracking-tight text-slate-950 md:text-4xl">
          Puntos de partida claros para cotizar y resolver dudas habituales
        </h2>
        <p class="mt-2 text-sm leading-6 text-slate-600">
          Los planes orientan el alcance inicial para desarrollo web y operación digital. Para software a medida o plataformas BaseLogic, evaluamos el requerimiento contigo.
        </p>
      </div>
      <div class="shrink-0">
        <a
          href="/planes"
          class="inline-flex items-center gap-2 rounded-full bg-slate-950 px-5 py-2.5 text-sm font-bold text-white transition hover:bg-brand-blue"
        >
          Ver detalle de planes y alcances
          <ArrowRight class="h-4 w-4" />
        </a>
      </div>
    </div>

    <!-- Sub-bloque A: Los 3 Planes Referenciales -->
    <div class="mt-10 grid gap-5 lg:grid-cols-3">
      {plans.map((plan, index) => (
        <article
          class:list={[
            'flex flex-col justify-between rounded-2xl border p-6',
            index === 1
              ? 'border-brand-blue/40 bg-blue-50/30 shadow-xs'
              : 'border-slate-200 bg-slate-50/70',
          ]}
        >
          <div>
            <div class="flex items-center justify-between gap-2">
              <h3 class="text-xl font-black text-slate-950">{plan.name}</h3>
              <span class="font-mono text-[11px] font-semibold text-slate-500">
                PLAN 0{index + 1}
              </span>
            </div>

            <div class="mt-3 flex items-baseline gap-2">
              <span class="font-mono text-xs font-semibold uppercase text-slate-500">Desde</span>
              <span class="tabular-nums text-3xl font-black text-brand-blue">{plan.price}</span>
              <span class="font-mono text-xs text-slate-500">referencial</span>
            </div>

            <p class="mt-3 text-sm leading-6 text-slate-600">{plan.summary}</p>

            <ul class="mt-4 space-y-2 border-t border-slate-200/80 pt-4 text-xs font-medium text-slate-700">
              {plan.includes.map((item) => (
                <li class="flex items-center gap-2">
                  <CheckCircle2 class="h-4 w-4 shrink-0 text-brand-blue" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="mt-5 border-t border-slate-200/60 pt-3">
            <p class="text-xs text-slate-500">
              <strong class="font-semibold text-slate-700">Orientado a:</strong> {plan.idealFor}
            </p>
          </div>
        </article>
      ))}
    </div>

    <!-- Nota de alcance comercial de los planes -->
    <div class="mt-5 rounded-xl border border-slate-200 bg-slate-50 px-5 py-3.5 text-xs leading-5 text-slate-600">
      {plansNotes.map((note) => (
        <p>{note}</p>
      ))}
    </div>

    <!-- Sub-bloque B: Preguntas Frecuentes Compactas -->
    <div class="mt-12 border-t border-slate-200 pt-10">
      <div class="grid gap-8 lg:grid-cols-[0.75fr_1.25fr] lg:items-start">
        <div>
          <span class="font-mono text-xs font-bold uppercase tracking-wider text-brand-blue">
            DUDAS FRECUENTES
          </span>
          <h3 class="mt-1.5 text-xl font-black text-slate-950 md:text-2xl">
            Respuestas directas antes de iniciar
          </h3>
          <p class="mt-2 text-sm leading-6 text-slate-600">
            Si tu consulta es específica sobre tu flujo de trabajo, escríbenos mediante el formulario y revisamos tu caso sin compromiso.
          </p>
          <a
            href="/contacto#formulario"
            class="mt-4 inline-flex items-center gap-1.5 text-sm font-bold text-brand-blue hover:text-slate-950"
          >
            Ir al formulario de evaluación
            <ArrowRight class="h-4 w-4" />
          </a>
        </div>

        <div class="grid gap-3">
          {generalFaqs.map((faq, idx) => (
            <details
              open={idx === 0}
              class="group rounded-xl border border-slate-200 bg-slate-50/70 p-4 transition open:border-brand-blue/30 open:bg-white"
            >
              <summary class="flex cursor-pointer list-none items-center justify-between gap-3 text-sm font-bold text-slate-950">
                <span>{faq.question}</span>
                <ChevronDown class="h-4 w-4 shrink-0 text-slate-500 transition-transform group-open:rotate-180" />
              </summary>
              <p class="mt-3 border-t border-slate-100 pt-3 text-xs leading-6 text-slate-600 sm:text-sm">
                {faq.answer}
              </p>
            </details>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
