---
import { ArrowRight, Check } from 'lucide-react';
import { plans, plansNotes } from '../data/plans';
---

<section class="border-t border-slate-200/70 bg-white py-20 md:py-24">
  <div class="mx-auto max-w-7xl px-5 md:px-8">
    <div class="mx-auto max-w-3xl text-center">
      <p class="text-[11px] font-bold uppercase tracking-[0.2em] text-brand-blue">Planes referenciales</p>
      <h2 class="mt-3 text-3xl font-extrabold tracking-tight text-slate-950 md:text-4xl">
        Puntos de partida claros para cotizar
      </h2>
      <p class="mt-4 text-base leading-relaxed text-slate-600 md:text-lg">
        Los planes ayudan a orientar el alcance inicial. Si tu operación requiere un desarrollo a medida o un producto propio, lo evaluamos contigo.
      </p>
    </div>

    <div class="mt-12 grid gap-6 lg:grid-cols-3">
      {plans.map((plan, idx) => {
        const isFeatured = idx === 1;
        return (
          <article
            class:list={[
              'relative flex flex-col justify-between rounded-3xl p-7 transition-all duration-300',
              isFeatured
                ? 'border-2 border-brand-blue/30 bg-[#f8fbff] shadow-[0_20px_50px_-24px_rgba(0,102,255,0.16)]'
                : 'border border-slate-200/90 bg-white shadow-[0_14px_34px_-22px_rgba(10,15,20,0.08)] hover:border-brand-blue/25',
            ]}
          >
            <div>
              <div class="flex items-center justify-between gap-2">
                <h3 class="text-xl font-extrabold tracking-tight text-slate-950">{plan.name}</h3>
                {isFeatured && (
                  <span class="rounded-full bg-brand-blue/10 px-2.5 py-0.5 text-[11px] font-bold text-brand-blue">
                    Más solicitado
                  </span>
                )}
              </div>
              <div class="mt-4 flex items-baseline gap-2">
                <span class="text-xs font-semibold uppercase tracking-wider text-slate-400">Desde</span>
                <span class="text-3xl font-extrabold tracking-tight text-slate-950 md:text-4xl">{plan.price}</span>
              </div>
              <p class="mt-4 text-sm leading-relaxed text-slate-600">{plan.summary}</p>
              <ul class="mt-6 space-y-2.5 border-t border-slate-200/70 pt-5 text-sm text-slate-700">
                {plan.includes.map((item) => (
                  <li class="flex items-start gap-2.5">
                    <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-brand-blue/10 text-brand-blue">
                      <Check class="h-2.5 w-2.5" />
                    </span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="mt-6 border-t border-slate-100 pt-4">
              <p class="text-xs leading-relaxed text-slate-500">
                <strong class="font-semibold text-slate-700">Ideal para:</strong> {plan.idealFor}
              </p>
            </div>
          </article>
        );
      })}
    </div>

    <div class="mt-8 flex flex-col items-start justify-between gap-5 rounded-2xl border border-slate-200/80 bg-slate-50/80 p-5 md:flex-row md:items-center md:px-7">
      <div class="space-y-1 text-xs leading-relaxed text-slate-500 md:text-sm">
        {plansNotes.map((note) => <p>{note}</p>)}
      </div>
      <a
        href="/planes"
        class="inline-flex shrink-0 items-center gap-2 rounded-full bg-slate-950 px-6 py-3 text-sm font-semibold text-white transition hover:bg-brand-blue"
      >
        Ver detalle de planes
        <ArrowRight class="h-4 w-4" />
      </a>
    </div>
  </div>
</section>
