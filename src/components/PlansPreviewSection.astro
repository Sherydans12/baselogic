---
import { ArrowRight } from 'lucide-react';
import SectionHeading from './SectionHeading.astro';
import { plans, plansNotes } from '../data/plans';
---

<section class="bg-white py-20">
  <div class="mx-auto max-w-7xl px-5 md:px-8">
    <SectionHeading
      eyebrow="Planes desde"
      title="Puntos de partida claros para cotizar"
      text="Los planes ayudan a orientar el alcance inicial. Si tu proyecto necesita algo distinto, lo evaluamos contigo."
      align="center"
    />
    <div class="grid gap-5 lg:grid-cols-3">
      {plans.map((plan) => (
        <article class="rounded-2xl border border-slate-200 bg-slate-50 p-6">
          <h3 class="text-2xl font-black text-slate-950">{plan.name}</h3>
          <p class="mt-3 text-sm font-semibold uppercase tracking-wide text-slate-500">Desde</p>
          <p class="mt-1 text-4xl font-black text-brand-blue">{plan.price}</p>
          <p class="mt-4 leading-7 text-slate-600">{plan.summary}</p>
          <ul class="mt-5 space-y-2 text-sm text-slate-700">
            {plan.includes.map((item) => (
              <li class="flex gap-2">
                <span class="mt-2 h-1.5 w-1.5 rounded-full bg-brand-cyan"></span>
                {item}
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
    <div class="mt-8 rounded-2xl border border-slate-200 bg-white p-5 text-sm leading-7 text-slate-600">
      {plansNotes.map((note) => <p>{note}</p>)}
    </div>
    <div class="mt-8 text-center">
      <a href="/planes" class="inline-flex items-center gap-2 rounded-full bg-slate-950 px-6 py-3 text-sm font-bold text-white hover:bg-brand-blue">
        Ver planes
        <ArrowRight class="h-4 w-4" />
      </a>
    </div>
  </div>
</section>
