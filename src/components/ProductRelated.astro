---
import { ArrowRight } from 'lucide-react';
import { products } from '../data/products';
interface Props { current: string }
const { current } = Astro.props;
---
<section class="bg-[#f7faff] py-14 md:py-16">
  <div class="mx-auto max-w-7xl px-5 md:px-8">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div><h2 class="text-3xl font-black tracking-[-0.03em] text-[#0b1a4c]">Conoce nuestras otras plataformas</h2><p class="mt-3 text-base leading-relaxed text-[#405578]">Soluciones para distintas formas de trabajar.</p></div>
      <a href="/productos" class="inline-flex min-h-11 items-center gap-2 text-sm font-bold text-[#0754c9] hover:text-[#0b1a4c] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#075be8]">Ver todos los productos <ArrowRight class="h-4 w-4" aria-hidden="true" /></a>
    </div>
    <div class="mt-6 grid gap-4 md:grid-cols-3">
      {products.filter((item) => item.id !== current).map((item) => (
        <a href={item.href} class="group flex flex-col rounded-2xl border border-[#dce8f8] bg-white p-5 transition-colors hover:border-[#9fc5f8] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#075be8]">
          <h3 class="text-lg font-extrabold text-[#0b1a4c]">{item.name}</h3>
          <p class="mt-2 flex-1 text-sm leading-relaxed text-[#405578]">{item.tagline}</p>
          <span class="mt-4 inline-flex items-center gap-2 text-sm font-bold text-[#0754c9]">Conocer producto <ArrowRight class="h-4 w-4 transition-transform group-hover:translate-x-1" aria-hidden="true" /></span>
        </a>
      ))}
    </div>
  </div>
</section>
