---
import { ArrowRight, CheckCircle2 } from 'lucide-react';
import { home } from '../data/home';
import { contact, createContactMailtoHref } from '../data/contact';

const contactHref = createContactMailtoHref(contact.whatsappMessages.general);
---

<section class="commercial-surface border-b border-slate-200">
  <div class="mx-auto grid min-h-[calc(100vh-80px)] max-w-7xl items-center gap-12 px-5 py-16 md:px-8 lg:grid-cols-[1.08fr_0.92fr]">
    <div>
      <p class="mb-5 inline-flex rounded-full border border-brand-cyan/30 bg-white px-4 py-2 text-sm font-bold text-brand-blue shadow-sm">
        Soluciones digitales para pymes y empresas en Chile
      </p>
      <h1 class="max-w-4xl text-4xl font-black leading-tight tracking-tight text-slate-950 md:text-6xl">
        {home.hero.title}
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-600 md:text-xl">
        {home.hero.subtitle}
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a
          href={home.hero.primaryCta.href}
          class="inline-flex items-center justify-center gap-2 rounded-full bg-brand-blue px-6 py-3.5 text-base font-bold text-white shadow-xl shadow-blue-700/15 transition hover:bg-slate-950"
        >
          {home.hero.primaryCta.label}
          <ArrowRight class="h-5 w-5" />
        </a>
        <a
          href={home.hero.secondaryCta.href}
          class="inline-flex items-center justify-center rounded-full border border-slate-300 bg-white px-6 py-3.5 text-base font-bold text-slate-800 transition hover:border-brand-cyan hover:text-brand-blue"
        >
          {home.hero.secondaryCta.label}
        </a>
      </div>
      <a href={contactHref} class="mt-5 inline-flex text-sm font-semibold text-slate-600 hover:text-brand-blue">
        Prefieres partir por correo? Hablemos con contexto simple.
      </a>
    </div>

    <div class="rounded-[2rem] border border-slate-200 bg-white p-5 shadow-2xl shadow-slate-900/10">
      <div class="rounded-[1.5rem] bg-slate-950 p-5 text-white">
        <div class="mb-6 flex items-center justify-between border-b border-white/10 pb-4">
          <div>
            <p class="text-sm font-bold text-brand-cyan">BaseLogic</p>
            <p class="text-xs text-slate-400">Panel de solucion digital</p>
          </div>
          <span class="rounded-full bg-emerald-400/10 px-3 py-1 text-xs font-bold text-emerald-300">Activo</span>
        </div>
        <div class="grid gap-3">
          {[
            'Pagina web profesional',
            'Formulario y correo',
            'Reservas o procesos',
            'Soporte y mejoras',
          ].map((item) => (
            <div class="flex items-center gap-3 rounded-2xl bg-white/7 p-4">
              <CheckCircle2 class="h-5 w-5 text-brand-cyan" />
              <span class="text-sm font-semibold text-slate-100">{item}</span>
            </div>
          ))}
        </div>
        <div class="mt-6 rounded-2xl bg-white p-4 text-slate-950">
          <p class="text-sm font-bold">Una base clara para crecer</p>
          <p class="mt-2 text-sm leading-6 text-slate-600">
            Partimos con lo que tu negocio necesita hoy y dejamos espacio para sumar automatizaciones, sistemas o productos propios.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
