---
/** Hero principal con contenido HTML y el panel operativo BaseLogic en laptop y móvil. */
import { ArrowRight, Layers, MapPin, ShieldCheck } from 'lucide-react';
import { home } from '../data/home';
---

<section class="relative isolate overflow-hidden border-b border-slate-200/70 bg-gradient-to-b from-[#eaf4fb] via-[#f6fbff] to-white">
  <!-- Iluminación ambiental suave fiel a los tokens originales (#00e5ff y #0066ff) -->
  <div class="pointer-events-none absolute -top-24 right-0 h-[560px] w-[560px] rounded-full bg-brand-cyan/15 blur-[130px]"></div>
  <div class="pointer-events-none absolute top-1/3 -left-32 h-[440px] w-[440px] rounded-full bg-brand-blue/10 blur-[120px]"></div>

  <div class="home-hero-grid relative grid items-stretch">
      <!-- Columna Izquierda: Contenido HTML Real, Jerarquía Tipográfica y CTAs -->
      <div class="home-hero-copy relative z-10 mx-auto flex w-full max-w-[760px] flex-col justify-center px-5 py-8 sm:px-8 md:py-14">
        <p class="text-[11px] font-extrabold uppercase tracking-[0.22em] text-slate-500 sm:text-xs">
          Claridad operacional
        </p>

        <h1 class="mt-3 text-[2.35rem] font-black leading-[1.06] tracking-tight text-slate-950 sm:text-5xl lg:text-[clamp(3rem,4.35vw,3.45rem)]">
          <span class="block">Tecnología que</span>
          <span class="block text-brand-blue">conecta y simplifica</span>
          <span class="block">tu operación.</span>
        </h1>

        <p class="mt-4 max-w-xl text-[15px] leading-relaxed text-slate-600 sm:mt-5 sm:text-lg sm:leading-8">
          {home.hero.subtitle}
        </p>

        <!-- CTAs principales visibles y accesibles -->
        <div class="home-hero-ctas mt-6 flex flex-wrap items-center gap-4 sm:mt-8 sm:gap-6">
          <a
            href="/contacto#formulario"
            class="home-hero-primary-cta group inline-flex items-center justify-center gap-2.5 rounded-xl bg-brand-blue px-6 py-3.5 text-sm font-bold text-white shadow-lg shadow-brand-blue/25 transition-all duration-200 hover:-translate-y-0.5 hover:bg-slate-950 hover:shadow-xl hover:shadow-slate-950/20 sm:px-7 sm:py-4 sm:text-base"
          >
            Hablemos de tu proyecto
            <ArrowRight class="h-4 w-4 transition-transform group-hover:translate-x-1" />
          </a>

          <a
            href="#servicios"
            class="inline-flex items-center gap-1.5 py-1.5 text-sm font-bold text-brand-blue underline decoration-brand-blue/40 underline-offset-8 transition hover:text-slate-950 hover:decoration-slate-950"
          >
            Ver servicios
          </a>
        </div>

        <!-- Tres pilares de confianza inferiores (en Desktop bajo los CTAs) -->
        <div class="mt-10 hidden grid-cols-3 gap-4 border-t border-slate-200/80 pt-6 lg:grid">
          <div class="flex items-start gap-2.5">
            <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-blue-50 text-brand-blue ring-1 ring-blue-100">
              <Layers class="h-4 w-4" />
            </div>
            <div>
              <p class="text-xs font-extrabold text-slate-950">A tu medida</p>
              <p class="mt-0.5 text-[11px] leading-4 text-slate-500">Webs, sistemas y software propio</p>
            </div>
          </div>

          <div class="flex items-start gap-2.5">
            <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-blue-50 text-brand-blue ring-1 ring-blue-100">
              <ShieldCheck class="h-4 w-4" />
            </div>
            <div>
              <p class="text-xs font-extrabold text-slate-950">Alcance claro</p>
              <p class="mt-0.5 text-[11px] leading-4 text-slate-500">Planificación y evolución por etapas</p>
            </div>
          </div>

          <div class="flex items-start gap-2.5">
            <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-blue-50 text-brand-blue ring-1 ring-blue-100">
              <MapPin class="h-4 w-4" />
            </div>
            <div>
              <p class="text-xs font-extrabold text-slate-950">En todo Chile</p>
              <p class="mt-0.5 text-[11px] leading-4 text-slate-500">Desde la Región de Coquimbo</p>
            </div>
          </div>
        </div>
      </div>

      <figure class="home-hero-visual relative isolate mx-5 aspect-[3/2] overflow-hidden rounded-[1.75rem] bg-gradient-to-br from-[#04358b] via-[#0066e8] to-[#00c8dc] shadow-xl shadow-blue-950/15 sm:mx-8">
        <picture class="absolute inset-0 block">
          <source
            media="(min-width: 1152px)"
            srcset="/images/generated/home/baselogic-operational-dashboard-desktop.png"
            type="image/png"
          />
          <img
            src="/images/generated/home/baselogic-operational-dashboard.png"
            alt="Panel de operación BaseLogic con indicadores y gráficos en laptop y aplicación móvil."
            width="1536"
            height="1024"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="home-hero-image h-full w-full object-cover"
          />
        </picture>
      </figure>

        <!-- En móvil, los pilares de confianza quedan después del visual principal. -->
        <div class="mx-5 mt-6 grid grid-cols-3 gap-2 border-t border-slate-200/80 pt-4 pb-8 text-center sm:mx-8 md:pb-14 lg:hidden">
          <div>
            <p class="text-[11px] font-extrabold text-slate-950">A tu medida</p>
            <p class="text-[10px] text-slate-500">Webs y software</p>
          </div>
          <div class="border-x border-slate-200/70 px-1">
            <p class="text-[11px] font-extrabold text-slate-950">Alcance claro</p>
            <p class="text-[10px] text-slate-500">Por etapas</p>
          </div>
          <div>
            <p class="text-[11px] font-extrabold text-slate-950">Todo Chile</p>
            <p class="text-[10px] text-slate-500">Soporte directo</p>
          </div>
        </div>
  </div>
</section>

<style>
  .home-hero-grid {
    grid-template-columns: minmax(0, 1fr);
  }

  .home-hero-visual {
    aspect-ratio: 3 / 2;
  }

  @media (min-width: 1152px) {
    .home-hero-grid {
      grid-template-columns: minmax(0, 0.94fr) minmax(0, 1.06fr);
      min-height: clamp(36rem, 45vw, 48rem);
    }

    .home-hero-copy {
      justify-self: end;
      max-width: 760px;
      padding: clamp(3rem, 5vw, 4.5rem) clamp(1.5rem, 3.5vw, 4rem);
    }

    .home-hero-visual {
      aspect-ratio: auto;
      margin: 0;
      border-radius: 0;
      box-shadow: none;
    }

    .home-hero-ctas {
      gap: 0.75rem;
    }

    .home-hero-primary-cta {
      padding-inline: 1.25rem;
    }
  }
</style>
