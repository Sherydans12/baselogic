---
import { ArrowRight } from 'lucide-react';
import SectionHeading from './SectionHeading.astro';
import { products } from '../data/products';
---

<section class="bg-white py-20">
  <div class="mx-auto max-w-7xl px-5 md:px-8">
    <SectionHeading
      eyebrow="Productos BaseLogic"
      title="Productos propios para necesidades frecuentes"
      text="Booking es el producto principal para negocios que trabajan con reservas. EduPay y EAM cubren pagos educativos y operaciones con activos."
    />
    <div class="grid gap-5 lg:grid-cols-3">
      {products.map((product) => (
        <article class:list={[
          'rounded-2xl border p-6 shadow-sm',
          product.id === 'booking' ? 'border-brand-blue bg-brand-soft' : 'border-slate-200 bg-white',
        ]}>
          <p class="mb-4 text-sm font-bold uppercase tracking-wide text-brand-blue">{product.eyebrow}</p>
          <h3 class="text-2xl font-black text-slate-950">{product.name}</h3>
          <p class="mt-3 text-lg font-semibold text-slate-700">{product.tagline}</p>
          <p class="mt-4 leading-7 text-slate-600">{product.summary}</p>
          <a href={product.href} class="mt-6 inline-flex items-center gap-2 text-sm font-bold text-brand-blue hover:text-slate-950">
            {product.ctaLabel}
            <ArrowRight class="h-4 w-4" />
          </a>
        </article>
      ))}
    </div>
  </div>
</section>
