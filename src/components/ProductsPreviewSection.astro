---
/**
 * ProductsPreviewSection.astro
 * Vista de los productos BaseLogic con acceso directo a cada ficha.
 */
import {
  ArrowRight,
  CalendarDays,
  GraduationCap,
  Layers,
  Package,
  ShoppingBasket,
  Settings,
  Store,
  UsersRound,
  Wrench,
} from 'lucide-react';

const products = [
  {
    name: 'BaseLogic Booking',
    href: '/productos/booking',
    image: '/images/productos/baselogic-booking.webp',
    imageAlt: 'Calendario de reservas con un reloj para gestionar horarios',
    icon: CalendarDays,
    description:
      'Gestión de reservas y disponibilidad para negocios de servicios y atención por turnos.',
    features: [
      { label: 'Reservas', icon: CalendarDays },
      { label: 'Profesionales y servicios', icon: UsersRound },
      { label: 'Horarios y recursos', icon: CalendarDays },
    ],
  },
  {
    name: 'BaseLogic EduPay',
    href: '/productos/edupay',
    image: '/images/productos/baselogic-edupay.webp',
    imageAlt: 'Birrete de graduación sobre libros para una plataforma educativa',
    icon: GraduationCap,
    description:
      'Un ecosistema escolar para conectar gestión académica, finanzas y familias.',
    features: [
      { label: 'Comunidad educativa', icon: UsersRound },
      { label: 'Gestión académica', icon: GraduationCap },
      { label: 'Registro de pagos', icon: Layers },
    ],
  },
  {
    name: 'BaseLogic EAM',
    href: '/productos/eam',
    image: '/images/productos/baselogic-eam.webp',
    imageAlt: 'Casco industrial y engranaje para gestión de activos y mantención',
    icon: Settings,
    description:
      'Gestión de activos, mantenimiento, compras y bodega para operaciones, minería e industria.',
    features: [
      { label: 'Activos y equipos', icon: Layers },
      { label: 'Mantención y OT', icon: Wrench },
      { label: 'Bodega e inventario', icon: Package },
    ],
  },
  {
    name: 'BaseLogic POS',
    href: '/productos/pos',
    image: '/images/productos/baselogic-pos.webp',
    imageAlt: 'Terminal de punto de venta con impresora de tickets',
    icon: Store,
    description:
      'Punto de venta para organizar catálogo, caja, ventas en efectivo y saldos de inventario.',
    features: [
      { label: 'Ventas y caja', icon: ShoppingBasket },
      { label: 'Saldos de inventario', icon: Package },
      { label: 'Catálogo y precios', icon: Layers },
    ],
  },
];
---

<section
  id="productos-destacados"
  aria-labelledby="products-heading"
  class="bl-home-section bl-home-section--soft scroll-mt-20"
>
  <div class="products-section-background pointer-events-none absolute inset-0" aria-hidden="true"></div>

  <div class="bl-home-section__container">
    <header class="bl-home-section__header" data-motion-reveal>
      <div>
        <p class="bl-home-section__eyebrow">Nuestros productos</p>
        <h2 id="products-heading" class="bl-home-section__title">
          Soluciones propias para <span class="text-[#1162f5]">operaciones reales</span>
        </h2>
      </div>

      <p class="bl-home-section__lede">
        Plataformas de software diseñadas por BaseLogic para resolver necesidades reales en educación, operaciones, comercio y servicios.
      </p>
    </header>

    <div class="mt-7 grid items-stretch gap-4 sm:grid-cols-2 sm:gap-5 xl:mt-8 xl:grid-cols-4 xl:gap-4">
      {products.map((product, index) => {
        const ProductIcon = product.icon;

        return (
          <a
            href={product.href}
            aria-label={`Ver detalles de ${product.name}`}
            data-motion-reveal
            style={`--home-motion-delay: ${Math.min(index * 55, 165)}ms`}
            class="bl-home-card bl-home-card--interactive product-card group flex min-w-0 flex-col overflow-hidden bg-white/85 transition-[transform,border-color,box-shadow] duration-300 ease-out hover:-translate-y-1 hover:border-[#b8d5fb] hover:shadow-[0_22px_44px_-30px_rgba(16,74,170,0.38)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#075be8]"
          >
            <div class="product-card-visual relative aspect-[1.85] overflow-hidden">
              <img
                src={product.image}
                alt={product.imageAlt}
                width="1040"
                height="620"
                loading="lazy"
                decoding="async"
                class="product-card-image h-full w-full object-contain transition-transform duration-500 ease-out group-hover:scale-[1.035]"
              />
            </div>

            <div class="flex flex-1 flex-col p-4 sm:p-5">
              <div class="flex min-h-12 items-center gap-3">
                <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl border border-[#d7e5f8] bg-white/90 text-[#0964ef] shadow-[0_5px_14px_-12px_rgba(0,77,180,0.45)]">
                  <ProductIcon class="h-7 w-7" aria-hidden="true" />
                </span>
                <h3 class="min-w-0 flex-1 text-lg font-black leading-tight tracking-[-0.025em] text-[#0b1a4c]">
                  {product.name}
                </h3>
              </div>

              <p class="mt-3 text-[0.96rem] leading-[1.5] text-[#31466d]">
                {product.description}
              </p>

              <div class="mt-4 flex flex-col items-start gap-2">
                {product.features.map((feature) => {
                  const FeatureIcon = feature.icon;

                  return (
                    <span class="inline-flex max-w-full items-center gap-2.5 rounded-full bg-[#eaf1fb] px-3 py-1.5 text-sm font-semibold leading-tight text-[#102556]">
                      <FeatureIcon class="h-4 w-4 shrink-0 text-[#0964ef]" aria-hidden="true" />
                      <span class="min-w-0">{feature.label}</span>
                    </span>
                  );
                })}
              </div>

              <span class="mt-auto flex items-center justify-between border-t border-[#dce6f5] pt-4 text-lg font-extrabold text-[#0964ef]">
                <span>Ver más</span>
                <ArrowRight class="product-card-arrow h-6 w-6 transition-transform duration-300 ease-out group-hover:translate-x-1" aria-hidden="true" />
              </span>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</section>

<style>
  .products-section-background {
    background-image: url('/images/productos/fondo-productos.svg');
    background-position: center;
    background-repeat: no-repeat;
    background-size: cover;
  }

  .product-card-visual {
    background: rgba(255, 255, 255, 0.34);
  }
</style>
