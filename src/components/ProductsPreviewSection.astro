---
import { ArrowRight, Calendar, CreditCard, ShieldAlert, CheckCircle2 } from 'lucide-react';
import SectionHeading from './SectionHeading.astro';
import { products } from '../data/products';
import { visualAssets } from '../data/visualAssets';

const productVisuals = {
  booking: visualAssets.products.bookingHero,
  edupay: visualAssets.products.edupayHero,
  eam: visualAssets.products.eamHero,
};

const productIcons = {
  booking: Calendar,
  edupay: CreditCard,
  eam: ShieldAlert,
};
---

<section class="bg-white py-20 md:py-28 border-b border-slate-200/80">
  <div class="mx-auto max-w-7xl px-5 md:px-8">
    <SectionHeading
      eyebrow="Productos BaseLogic"
      title="Plataformas propias para necesidades operacionales reales"
      text="Soluciones de software diseñadas en Chile para distintos sectores: Booking organiza agendas y disponibilidad, EduPay estructura la gestión financiera escolar y EAM centraliza el control de activos, abastecimiento y mantenimiento."
    />

    <div class="mt-12 grid gap-8 lg:grid-cols-3">
      {products.map((product) => {
        const visual = productVisuals[product.id as keyof typeof productVisuals];
        const Icon = productIcons[product.id as keyof typeof productIcons];
        const isFeatured = product.id === 'booking';

        return (
          <article class:list={[
            'group relative flex flex-col overflow-hidden rounded-3xl border transition-all duration-300 hover:-translate-y-1',
            isFeatured
              ? 'border-brand-blue/40 bg-gradient-to-b from-blue-50/60 via-white to-white shadow-xl shadow-blue-600/10 hover:shadow-2xl hover:shadow-blue-600/20'
              : 'border-slate-200/90 bg-white shadow-sm hover:border-slate-300 hover:shadow-xl hover:shadow-slate-900/10',
          ]}>
            <!-- Top Visual Image Container -->
            <div class="relative aspect-[16/10] w-full overflow-hidden bg-slate-100 border-b border-slate-100">
              {visual && visual.src ? (
                <img
                  src={visual.src}
                  alt={visual.alt}
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                  style={visual.objectPosition ? `object-position: ${visual.objectPosition};` : undefined}
                />
              ) : (
                <div class="flex h-full items-center justify-center bg-slate-100 text-slate-400">
                  <Icon class="h-12 w-12" />
                </div>
              )}
            </div>

            <!-- Content Area -->
            <div class="flex flex-1 flex-col p-6 md:p-7">
              <h3 class="text-2xl font-black text-slate-950">{product.name}</h3>
              <p class="mt-1 text-sm font-semibold text-brand-blue">{product.tagline}</p>
              <p class="mt-3 leading-relaxed text-slate-600 text-sm">{product.summary}</p>

              <!-- Feature Checkmarks -->
              <ul class="mt-5 space-y-2 border-t border-slate-100 pt-4 text-xs font-semibold text-slate-700">
                <li class="flex items-center gap-2">
                  <CheckCircle2 class="h-4 w-4 text-emerald-500 shrink-0" />
                  <span>Evaluación de alcance y acompañamiento en Chile</span>
                </li>
                <li class="flex items-center gap-2">
                  <CheckCircle2 class="h-4 w-4 text-emerald-500 shrink-0" />
                  <span>Interfaz clara y alineada a la operación real</span>
                </li>
              </ul>

              <div class="mt-6 pt-2">
                <a
                  href={product.href}
                  class:list={[
                    'inline-flex w-full items-center justify-center gap-2 rounded-full py-3 px-4 text-sm font-bold transition-all duration-200',
                    isFeatured
                      ? 'bg-brand-blue text-white shadow-md shadow-blue-600/20 hover:bg-slate-950 hover:shadow-lg'
                      : 'border border-slate-200 bg-slate-50 text-slate-800 hover:border-brand-blue/30 hover:bg-brand-blue hover:text-white',
                  ]}
                >
                  {product.ctaLabel}
                  <ArrowRight class="h-4 w-4 transition-transform group-hover:translate-x-1" />
                </a>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>
