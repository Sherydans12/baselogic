---
import SectionHeading from './SectionHeading.astro';

interface Props {
  title: string;
  text?: string;
  items: string[];
}

const { title, text, items } = Astro.props;
---

<section class="bg-white py-18 md:py-20">
  <div class="mx-auto max-w-7xl px-5 md:px-8">
    <SectionHeading title={title} text={text} />
    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
      {items.map((item) => (
        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-5">
          <span class="mb-4 block h-2 w-12 rounded-full bg-brand-cyan"></span>
          <h2 class="text-lg font-black text-slate-950">{item}</h2>
        </div>
      ))}
    </div>
  </div>
</section>
