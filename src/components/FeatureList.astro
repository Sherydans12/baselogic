---
import SectionHeading from './SectionHeading.astro';

interface Props {
  title: string;
  text?: string;
  items: string[];
  variant?: 'white' | 'soft';
}

const { title, text, items, variant = 'soft' } = Astro.props;
---

<section class:list={[variant === 'white' ? 'bg-white' : 'bg-brand-soft', 'py-18 md:py-20']}>
  <div class="mx-auto max-w-7xl px-5 md:px-8">
    <SectionHeading title={title} text={text} />
    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {items.map((item) => (
        <div class="rounded-2xl border border-slate-200 bg-white p-5 font-semibold leading-7 text-slate-800 shadow-sm">
          {item}
        </div>
      ))}
    </div>
  </div>
</section>
