---
interface Breadcrumb {
  label: string;
  href?: string;
}

interface Props {
  items: Breadcrumb[];
}

const { items } = Astro.props;
---

<nav class="bg-white pt-6" aria-label="Breadcrumb">
  <ol class="mx-auto flex max-w-7xl flex-wrap items-center gap-2 px-5 text-sm font-semibold text-slate-500 md:px-8">
    {items.map((item, index) => (
      <li class="flex items-center gap-2">
        {item.href ? (
          <a href={item.href} class="hover:text-brand-blue">{item.label}</a>
        ) : (
          <span class="text-slate-800" aria-current="page">{item.label}</span>
        )}
        {index < items.length - 1 && <span class="text-slate-300">/</span>}
      </li>
    ))}
  </ol>
</nav>
